.favorite-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #596f69;
  box-shadow: none;
  line-height: 1;
}

.favorite-toggle::after {
  border: 0;
}

.favorite-toggle.compact {
  width: 80rpx;
  min-width: 80rpx;
  height: 80rpx;
}

.favorite-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid rgba(38, 86, 75, 0.14);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(22, 62, 52, 0.09);
}

.favorite-toggle.compact .favorite-visual {
  width: 50rpx;
  height: 50rpx;
}

.favorite-toggle.active .favorite-visual {
  border-color: rgba(190, 77, 84, 0.24);
  color: #bd4f57;
  background: rgba(255, 245, 246, 0.95);
}

.favorite-toggle[disabled] {
  opacity: 0.62;
}

.favorite-toggle.syncing {
  opacity: 0.72;
}

.favorite-icon {
  font-size: 30rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.favorite-toggle.compact .favorite-icon {
  font-size: 28rpx;
}

/**app.wxss**/
page {
  --brand-green: #284C44;
  --brand-green-dark: #142824;
  --brand-green-soft: #EAF1EC;
  --brand-cream: #F4F0E8;
  --brand-orange: #A97945;
  --brand-blue: #9AB7B8;
  --brand-blue-soft: #EAF2F1;
  --brand-yellow: #B89455;
  --brand-yellow-soft: #E9D9B8;
  --brand-line: #D9D2C6;
  --brand-muted: #65716D;
  --brand-card: #FFFDF8;
  min-height: 100vh;
  color: var(--brand-green-dark);
  background: var(--brand-cream);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  width: auto;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  color: inherit;
  font: inherit;
  background: transparent;
  border: 0;
  border-radius: 0;
  text-align: inherit;
}

button::after {
  border: 0;
}

.page-scroll {
  flex: 1;
  height: 100%;
  overflow-y: hidden;
}

.page-shell {
  min-height: 100%;
  padding: 24rpx 28rpx 44rpx;
  background:
    linear-gradient(180deg, #F9F6EF 0%, var(--brand-cream) 340rpx, #EFEAE0 100%);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 18rpx;
}

.section-title-main {
  color: var(--brand-green-dark);
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.section-title-action {
  color: var(--brand-green);
  font-size: 24rpx;
  font-weight: 800;
}

.soft-card {
  background: var(--brand-card);
  border: 1rpx solid rgba(217, 210, 198, 0.92);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(20, 40, 36, 0.055);
}

.brand-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #315B51 0%, var(--brand-green-dark) 100%);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 22rpx rgba(20, 40, 36, 0.14);
}

.sun-button {
  color: var(--brand-green-dark);
  background: var(--brand-yellow-soft);
  box-shadow: none;
}

.muted-text {
  color: var(--brand-muted);
}

.listing-feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.listing-feature-tag,
.listing-maintenance-tag,
.listing-relevance-tag {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  color: var(--brand-green);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
  background: rgba(46, 81, 74, 0.09);
  border-radius: 14rpx;
}

.listing-maintenance-tag {
  color: #6A5636;
  background: rgba(184, 148, 85, 0.18);
}

.listing-relevance-tag {
  color: var(--brand-green-dark);
  background: var(--brand-yellow-soft);
}

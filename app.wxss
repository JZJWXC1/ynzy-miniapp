/**app.wxss**/
page {
  --brand-green: #326955;
  --brand-green-dark: #173D33;
  --brand-green-soft: #EAF2EC;
  --brand-cream: #F8F3EA;
  --brand-orange: #C9923F;
  --brand-blue: #9ED8E7;
  --brand-blue-soft: #EFF8F9;
  --brand-yellow: #E6BE62;
  --brand-yellow-soft: #F7E9C4;
  --brand-line: #DCE4DA;
  --brand-muted: #667469;
  --brand-card: #FFFDF8;
  min-height: 100vh;
  color: var(--brand-green-dark);
  background: var(--brand-cream);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  width: auto;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  color: inherit;
  font: inherit;
  background: transparent;
  border: 0;
  border-radius: 0;
  text-align: inherit;
}

button::after {
  border: 0;
}

.page-scroll {
  flex: 1;
  height: 100%;
  overflow-y: hidden;
}

.page-shell {
  min-height: 100%;
  padding: 24rpx 28rpx 44rpx;
  background:
    linear-gradient(180deg, #FBF8F1 0%, var(--brand-cream) 360rpx, #FAF7F0 100%);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 18rpx;
}

.section-title-main {
  color: var(--brand-green-dark);
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.section-title-action {
  color: var(--brand-green);
  font-size: 24rpx;
  font-weight: 800;
}

.soft-card {
  background: var(--brand-card);
  border: 1rpx solid var(--brand-line);
  border-radius: 24rpx;
  box-shadow: 0 14rpx 32rpx rgba(23, 61, 51, 0.06);
}

.brand-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  background: var(--brand-green);
  border-radius: 22rpx;
}

.sun-button {
  color: var(--brand-green-dark);
  background: var(--brand-yellow);
}

.muted-text {
  color: var(--brand-muted);
}

.listing-feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.listing-feature-tag,
.listing-maintenance-tag,
.listing-relevance-tag {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  color: var(--brand-green);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
  background: rgba(50, 105, 85, 0.09);
  border-radius: 14rpx;
}

.listing-maintenance-tag {
  color: #6D5521;
  background: rgba(230, 190, 98, 0.24);
}

.listing-relevance-tag {
  color: var(--brand-green-dark);
  background: var(--brand-yellow);
}

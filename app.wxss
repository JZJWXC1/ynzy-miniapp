/**app.wxss**/
page {
  min-height: 100vh;
  color: #17342e;
  background: #f7fbf8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
scroll-view,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  width: auto;
  min-width: 0;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1;
  color: inherit;
  font: inherit;
  background: transparent;
  border: 0;
  border-radius: 0;
  text-align: inherit;
}

button::after {
  border: 0;
}

.page-scroll {
  flex: 1;
  height: 100%;
  overflow-y: hidden;
}

.page-shell {
  min-height: 100%;
  padding: 24rpx 28rpx 44rpx;
  background:
    linear-gradient(180deg, #eef8f3 0%, #f7fbf8 360rpx, #f7fbf8 100%);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 18rpx;
}

.section-title-main {
  color: #153f36;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.section-title-action {
  color: #2f6f60;
  font-size: 24rpx;
  font-weight: 800;
}

.soft-card {
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 38rpx rgba(31, 81, 68, 0.08);
}

.brand-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 28rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  background: #2f6f60;
  border-radius: 22rpx;
}

.sun-button {
  color: #153f36;
  background: #f6bd36;
}

.muted-text {
  color: #78918a;
}

.listing-feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.listing-feature-tag,
.listing-maintenance-tag,
.listing-relevance-tag {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  color: #2f6f60;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
  background: #e9f5f0;
  border-radius: 14rpx;
}

.listing-maintenance-tag {
  color: #8a5b00;
  background: #fff3cf;
}

.listing-relevance-tag {
  color: #153f36;
  background: #f6bd36;
}

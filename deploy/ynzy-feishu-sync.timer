[Unit]
Description=每 30 分钟检查一次 Ynzy 飞书房源同步

[Timer]
OnBootSec=10min
# 固定墙钟每半小时检查；即使上一轮运行超过 30 分钟，后续日历触发仍会继续存在，
# 不会像 OnUnitActiveSec 那样因“触发时服务仍 active”而失去下一次调度。
OnCalendar=*-*-* *:00,30:00
AccuracySec=1min
RandomizedDelaySec=90
Persistent=true
Unit=ynzy-feishu-sync.service

[Install]
WantedBy=timers.target

[Unit]
Description=Ynzy Miniapp 飞书房源同步工作器
Wants=network-online.target
After=network-online.target ynzy-miniapp.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ynzy-miniapp/server
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node scripts/run-feishu-sync-worker.js --schedule
TimeoutStartSec=5h
Nice=5

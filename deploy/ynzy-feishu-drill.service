[Unit]
Description=Ynzy Miniapp 从飞书拉回最新 .ygbak 恢复演练 (P0-1 闭环)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ynzy-miniapp/server
# 需要 BACKUP_ENCRYPTION_KEY 解密、FEISHU_BACKUP_* 拉回；与备份服务同一环境文件。
EnvironmentFile=/etc/default/ynzy-backup
ExecStart=/usr/bin/env node scripts/restore-drill-from-feishu.js

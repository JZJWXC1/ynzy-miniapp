/**index.wxss**/
.tab-safe {
  --brand-green: #2E6B4E;
  --brand-green-dark: #174331;
  --brand-cream: #FBF5EA;
  --brand-blue: #8FD0E8;
  --brand-yellow: #F8D06B;
  --brand-line: #DDE7DA;
  --brand-muted: #6E8174;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  background: transparent;
  pointer-events: none;
}

.tab-shell {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  background: rgba(251, 245, 234, 0.96);
  border: 1rpx solid var(--brand-line, #DDE7DA);
  border-radius: 36rpx;
  box-shadow: 0 18rpx 36rpx rgba(46, 107, 78, 0.14);
  pointer-events: auto;
}

.tab-item {
  flex: 1 1 0;
  min-width: 0;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--brand-muted, #6E8174);
  border-radius: 28rpx;
  pointer-events: auto;
}

.tab-item-hover {
  background: rgba(46, 107, 78, 0.08);
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 900;
  border-radius: 16rpx;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.tab-item.active {
  color: var(--brand-green, #2E6B4E);
}

.tab-item.active .tab-icon {
  color: var(--brand-green, #2E6B4E);
  background: rgba(248, 208, 107, 0.5);
}

.tab-item:nth-child(3).active .tab-icon {
  color: var(--brand-green-dark, #174331);
  background: var(--brand-blue, #8FD0E8);
}

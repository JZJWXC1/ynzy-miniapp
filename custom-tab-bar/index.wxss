/**index.wxss**/
.tab-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.tab-shell {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dce9e3;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 36rpx rgba(31, 81, 68, 0.14);
}

.tab-item {
  flex: 1 1 0;
  min-width: 0;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #78918a;
  border-radius: 28rpx;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 900;
  border-radius: 16rpx;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.tab-item.active {
  color: #2f6f60;
}

.tab-item.active .tab-icon {
  color: #2f6f60;
  background: #e9f5f0;
}

.tab-item:nth-child(3).active .tab-icon {
  color: #153f36;
  background: #fff3cf;
}

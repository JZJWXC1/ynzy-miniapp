/**index.wxss**/
.tab-safe {
  --brand-green: #326955;
  --brand-green-dark: #173D33;
  --brand-cream: #F8F3EA;
  --brand-blue: #9ED8E7;
  --brand-blue-soft: #EFF8F9;
  --brand-yellow: #E6BE62;
  --brand-yellow-soft: #F7E9C4;
  --brand-line: #DCE4DA;
  --brand-muted: #667469;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  background: transparent;
  pointer-events: none;
}

.tab-shell {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  background: rgba(255, 253, 248, 0.94);
  border: 1rpx solid var(--brand-line, #DCE4DA);
  border-radius: 36rpx;
  box-shadow: 0 16rpx 32rpx rgba(23, 61, 51, 0.1);
  pointer-events: auto;
}

.tab-item {
  flex: 1 1 0;
  min-width: 0;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--brand-muted, #667469);
  border-radius: 28rpx;
  pointer-events: auto;
}

.tab-item-hover {
  background: rgba(50, 105, 85, 0.07);
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 900;
  border-radius: 16rpx;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.tab-item.active {
  color: var(--brand-green, #326955);
}

.tab-item.active .tab-icon {
  color: var(--brand-green, #326955);
  background: var(--brand-yellow-soft, #F7E9C4);
}

.tab-item:nth-child(3).active .tab-icon {
  color: var(--brand-green-dark, #173D33);
  background: var(--brand-blue-soft, #EAF8FC);
}

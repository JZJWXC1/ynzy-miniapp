/**index.wxss**/
.tab-safe {
  --brand-green: #284C44;
  --brand-green-dark: #142824;
  --brand-cream: #F4F0E8;
  --brand-blue: #9AB7B8;
  --brand-blue-soft: #EAF2F1;
  --brand-yellow: #B89455;
  --brand-yellow-soft: #E9D9B8;
  --brand-line: #D9D2C6;
  --brand-muted: #65716D;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  background: transparent;
  pointer-events: none;
}

.tab-shell {
  height: 112rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  background: rgba(255, 253, 248, 0.96);
  border: 1rpx solid rgba(217, 210, 198, 0.96);
  border-radius: 36rpx;
  box-shadow: 0 14rpx 30rpx rgba(20, 40, 36, 0.095);
  pointer-events: auto;
}

.tab-item {
  flex: 1 1 0;
  min-width: 0;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: var(--brand-muted, #66736E);
  border-radius: 28rpx;
  pointer-events: auto;
}

.tab-item-hover {
  background: rgba(40, 76, 68, 0.07);
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 900;
  border-radius: 16rpx;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.tab-item.active {
  color: var(--brand-green, #284C44);
}

.tab-item.active .tab-icon {
  color: var(--brand-green-dark, #142824);
  background: linear-gradient(135deg, rgba(233, 217, 184, 0.96), rgba(234, 242, 241, 0.86));
}

.tab-item:nth-child(3).active .tab-icon {
  color: var(--brand-green-dark, #142824);
  background: var(--brand-blue-soft, #EAF2F1);
}

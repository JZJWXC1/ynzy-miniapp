<!--index.wxml-->
<view class="tab-safe">
  <view class="tab-shell">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      catchtap="switchTab"
      hover-class="tab-item-hover"
      hover-stay-time="80"
      aria-role="button"
      aria-label="{{item.text}}"
    >
      <view class="tab-icon">{{item.icon}}</view>
      <view class="tab-text">{{item.text}}</view>
    </view>
  </view>
</view>

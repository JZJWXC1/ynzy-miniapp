page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.auth-page {
  padding-bottom: 80rpx;
}

.auth-hero {
  display: flex;
  gap: 22rpx;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e9f5f0 100%);
  border: 1rpx solid #dce9e3;
  border-radius: 34rpx;
}

.auth-hero > view:nth-child(2) {
  min-width: 0;
  flex: 1 1 auto;
}

.auth-logo {
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  background: #ffffff;
  border-radius: 30rpx;
}

.auth-title {
  color: #153f36;
  font-size: 38rpx;
  font-weight: 900;
}

.auth-desc {
  margin-top: 12rpx;
  color: #78918a;
  font-size: 24rpx;
  line-height: 1.5;
}

.mode-switch {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.mode-switch button {
  flex: 1 1 0;
  min-width: 0;
  height: 76rpx;
  color: #2f6f60;
  font-size: 27rpx;
  font-weight: 900;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 22rpx;
}

.mode-switch button.active {
  color: #ffffff;
  background: #2f6f60;
  border-color: #2f6f60;
}

.auth-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #153f36;
  font-size: 25rpx;
  font-weight: 900;
}

input {
  height: 76rpx;
  padding: 0 22rpx;
  color: #153f36;
  font-size: 26rpx;
  background: #f7fbf8;
  border: 1rpx solid #dce9e3;
  border-radius: 22rpx;
}

.submit-button {
  width: 100%;
  height: 84rpx;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #2f6f60;
  border-radius: 26rpx;
}

.auth-note {
  margin-top: 22rpx;
  color: #78918a;
  font-size: 23rpx;
  line-height: 1.55;
}

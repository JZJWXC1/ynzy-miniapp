page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.auth-page {
  padding-bottom: 80rpx;
}

.auth-hero {
  display: flex;
  gap: 22rpx;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #EDF3EF 100%);
  border: 1rpx solid #DED8CC;
  border-radius: 34rpx;
}

.auth-hero > view:nth-child(2) {
  min-width: 0;
  flex: 1 1 auto;
}

.auth-logo {
  flex: 0 0 116rpx;
  width: 116rpx;
  height: 116rpx;
  background: #ffffff;
  border-radius: 30rpx;
}

.auth-title {
  color: #182E2A;
  font-size: 38rpx;
  font-weight: 900;
}

.auth-desc {
  margin-top: 12rpx;
  color: #6A7671;
  font-size: 24rpx;
  line-height: 1.5;
}

.mode-switch {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.mode-switch button {
  flex: 1 1 0;
  min-width: 0;
  height: 76rpx;
  color: #2E514A;
  font-size: 27rpx;
  font-weight: 900;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 22rpx;
}

.mode-switch button.active {
  color: #ffffff;
  background: #2E514A;
  border-color: #2E514A;
}

.auth-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #182E2A;
  font-size: 25rpx;
  font-weight: 900;
}

input {
  height: 76rpx;
  padding: 0 22rpx;
  color: #182E2A;
  font-size: 26rpx;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 22rpx;
}

.consent-panel {
  margin: 4rpx 0 20rpx;
  padding: 20rpx 22rpx;
  color: #526963;
  font-size: 23rpx;
  line-height: 1.65;
  background: #F7FAF8;
  border: 1rpx solid #DCE7E1;
  border-radius: 20rpx;
}

.consent-checkbox-group,
.consent-checkbox-label,
.consent-links {
  display: flex;
  align-items: center;
}

.consent-checkbox-label {
  min-height: 48rpx;
  font-weight: 700;
}

.consent-checkbox-label checkbox {
  margin-right: 8rpx;
  transform: scale(0.84);
  transform-origin: left center;
}

.consent-links {
  flex-wrap: wrap;
  margin-top: 4rpx;
  padding-left: 50rpx;
}

.agreement-link {
  width: auto;
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 0;
  color: #246955;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.65;
  text-decoration: underline;
  background: transparent;
  border: 0;
  border-radius: 0;
}

.agreement-link::after {
  display: none;
}

.submit-button {
  width: 100%;
  height: 84rpx;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #2E514A;
  border-radius: 26rpx;
}

.auth-note {
  margin-top: 22rpx;
  color: #6A7671;
  font-size: 23rpx;
  line-height: 1.55;
}

/**groups.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.groups-page {
  padding-bottom: 180rpx;
}

.group-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #182E2A 0%, #2E514A 100%);
  border-radius: 40rpx;
  box-shadow: 0 18rpx 42rpx rgba(46, 81, 74, 0.2);
}

.group-hero-main {
  flex: 1;
}

.group-kicker {
  color: #C9A45D;
  font-size: 24rpx;
  font-weight: 900;
}

.group-title {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.24;
}

.group-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
  line-height: 1.55;
}

.point-box {
  min-width: 120rpx;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #182E2A;
  background: #C9A45D;
  border-radius: 34rpx;
}

.point-value {
  font-size: 42rpx;
  font-weight: 900;
}

.point-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.group-actions {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 26rpx rgba(36, 62, 56, 0.06);
}

.group-form-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.group-form-grid input {
  height: 72rpx;
  padding: 0 20rpx;
  color: #182E2A;
  font-size: 25rpx;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 20rpx;
}

.upload-group-button {
  width: 100%;
  height: 78rpx;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  background: #2E514A;
  border-radius: 24rpx;
}

.normal-tip {
  margin-top: 14rpx;
  color: #6A7671;
  font-size: 23rpx;
  text-align: center;
}

.screenshot-picker {
  min-height: 196rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  background: #F6F2EA;
  border: 2rpx dashed #C9D6CF;
  border-radius: 22rpx;
}

.screenshot-preview {
  width: 100%;
  height: 260rpx;
  display: block;
}

.screenshot-empty {
  min-height: 196rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #2E514A;
  font-size: 25rpx;
  font-weight: 900;
}

.screenshot-plus {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 42rpx;
  line-height: 1;
  background: #2E514A;
  border-radius: 50%;
}

.audit-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.audit-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #DED8CC;
}

.audit-row:last-child {
  border-bottom: 0;
}

.audit-title {
  color: #182E2A;
  font-size: 26rpx;
  font-weight: 900;
}

.audit-time {
  margin-top: 6rpx;
  color: #6A7671;
  font-size: 22rpx;
}

.audit-status {
  flex: 0 0 190rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  color: #2E514A;
  font-size: 22rpx;
  font-weight: 900;
  text-align: right;
}

.group-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.group-card {
  flex: 1 1 190rpx;
  min-width: 0;
  min-height: 164rpx;
  padding: 22rpx 16rpx;
}

.group-card.locked {
  background: #F1E4C8;
}

.group-card.unlocked {
  background: #ffffff;
}

.group-name {
  color: #182E2A;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.3;
}

.group-count {
  margin-top: 10rpx;
  color: #2E514A;
  font-size: 28rpx;
  font-weight: 900;
}

.group-tag {
  margin-top: 10rpx;
  color: #6A7671;
  font-size: 21rpx;
  line-height: 1.35;
}

.shared-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.shared-card {
  padding: 26rpx;
}

.shared-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.shared-title {
  color: #182E2A;
  font-size: 31rpx;
  font-weight: 900;
}

.shared-publisher {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 23rpx;
}

.shared-price {
  flex: 0 0 auto;
  color: #B9655A;
  font-size: 31rpx;
  font-weight: 900;
}

.shared-info {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.shared-rule,
.shared-status {
  flex: 1 1 260rpx;
  min-width: 0;
  min-height: 62rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  color: #2E514A;
  font-size: 23rpx;
  font-weight: 800;
  background: #EDF3EF;
  border-radius: 20rpx;
}

.shared-status {
  color: #836033;
  background: #F1E4C8;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.action-chip {
  flex: 1 1 130rpx;
  min-width: 0;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #182E2A;
  font-size: 22rpx;
  font-weight: 900;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 18rpx;
}

.point-log {
  padding: 22rpx;
}

.point-log-item {
  padding: 14rpx 0;
  color: #182E2A;
  font-size: 25rpx;
  border-bottom: 1rpx solid #DED8CC;
}

.point-log-item:last-child {
  border-bottom: 0;
}

.group-empty {
  padding: 28rpx;
  background: #ffffff;
}

.group-empty-title {
  color: #182E2A;
  font-size: 28rpx;
  font-weight: 900;
}

.group-empty-desc {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 23rpx;
  line-height: 1.45;
}

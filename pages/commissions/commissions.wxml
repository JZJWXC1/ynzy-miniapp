<navigation-bar title="分佣记录" back="{{true}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell commission-page">
    <view class="hero-card">
      <view>
        <view class="hero-kicker">合作成交</view>
        <view class="hero-title">管理员确认签单后，上传人按配置快照结算。</view>
        <view class="hero-desc">每笔成交以确认记录里的比例和金额为准，后续配置调整不影响历史记录。</view>
      </view>
      <view class="hero-mark">佣</view>
    </view>

    <view class="stats-row">
      <view wx:for="{{stats}}" wx:key="label" class="stat-card">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section-title">
      <view class="section-title-main">最近分佣</view>
      <view class="section-title-action">{{records.length}} 单</view>
    </view>

    <view class="commission-list">
      <view wx:for="{{records}}" wx:key="id" class="commission-card soft-card" bindtap="openListing" data-id="{{item.listingId}}">
        <view class="commission-head">
          <view class="commission-title">{{item.title}}</view>
          <view class="commission-rate">{{item.settlementRule}}</view>
        </view>
        <view class="commission-meta">预计到手 {{item.uploaderCommissionText}}</view>
        <view class="commission-meta">{{item.role}} · 上传人 {{item.uploader}} · 成交人 {{item.dealer}}</view>
        <view class="commission-bottom">
          <view class="commission-status">{{item.status}}</view>
          <view class="commission-time">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>

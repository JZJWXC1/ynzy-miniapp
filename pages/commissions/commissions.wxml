<navigation-bar title="分佣记录" back="{{true}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell commission-page">
    <view class="hero-card">
      <view>
        <view class="hero-kicker">历史分佣</view>
        <view class="hero-title">当前报备与签单暂停，这里只读展示既有分佣快照。</view>
        <view class="hero-desc">历史记录以确认时冻结的比例和金额为准，后续配置调整不影响既有记录。</view>
      </view>
      <view class="hero-mark">佣</view>
    </view>

    <view class="stats-row">
      <view wx:for="{{stats}}" wx:key="label" class="stat-card">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section-title">
      <view class="section-title-main">最近分佣</view>
      <view class="section-title-action">{{records.length}} 单</view>
    </view>

    <view wx:if="{{loadFailed}}" class="commission-card soft-card">
      <view class="commission-title">分佣记录加载失败</view>
      <view class="commission-meta">已保留上次结果，请检查网络后重试。</view>
      <button class="brand-button" style="margin-top: 20rpx;" bindtap="retryRecords">重新加载</button>
    </view>

    <view wx:if="{{!records.length && loading}}" class="commission-card soft-card">
      <view class="commission-title">正在加载分佣记录</view>
    </view>

    <view wx:if="{{!records.length && !loading && !loadFailed}}" class="commission-card soft-card">
      <view class="commission-title">暂无分佣记录</view>
      <view class="commission-meta">当前没有历史分佣快照；暂停期间不会新增报备或签单。</view>
    </view>

    <view class="commission-list">
      <view wx:for="{{records}}" wx:key="id" class="commission-card soft-card" bindtap="openListing" data-id="{{item.listingId}}">
        <view class="commission-head">
          <view class="commission-title">{{item.title}}</view>
          <view class="commission-rate">{{item.settlementRule}}</view>
        </view>
        <view class="commission-meta">预计到手 {{item.uploaderCommissionText}}</view>
        <view class="commission-meta">{{item.role}} · 上传人 {{item.uploader}} · 成交人 {{item.dealer}}</view>
        <view class="commission-bottom">
          <view class="commission-status">{{item.status}}</view>
          <view class="commission-time">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.commission-page {
  padding-bottom: 80rpx;
}

.hero-card {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  color: #ffffff;
  background: #2E514A;
  border-radius: 40rpx;
  box-shadow: 0 18rpx 42rpx rgba(46, 81, 74, 0.18);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: #182E2A;
  font-size: 42rpx;
  font-weight: 900;
  background: #C9A45D;
  border-radius: 30rpx;
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-card {
  flex: 1 1 190rpx;
  min-width: 0;
  padding: 22rpx 8rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 26rpx;
}

.stat-value {
  color: #182E2A;
  font-size: 34rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 6rpx;
  color: #6A7671;
  font-size: 22rpx;
}

.commission-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.commission-card {
  padding: 24rpx;
}

.commission-head,
.commission-bottom {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
}

.commission-title {
  color: #182E2A;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.commission-rate {
  flex: 0 1 360rpx;
  padding: 8rpx 14rpx;
  color: #836033;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
  background: #F1E4C8;
  border-radius: 16rpx;
}

.commission-meta,
.commission-time {
  margin-top: 12rpx;
  color: #6A7671;
  font-size: 23rpx;
  line-height: 1.45;
}

.commission-status {
  color: #2E514A;
  font-size: 24rpx;
  font-weight: 900;
}

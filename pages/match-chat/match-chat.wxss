page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #F6F2EA;
}

.chat-page {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background:
    linear-gradient(180deg, #EEF3EF 0%, #F6F2EA 320rpx, #F6F2EA 100%);
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.chat-shell {
  min-height: 100%;
  padding: 24rpx 28rpx 178rpx;
}

.service-head {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(46, 81, 74, 0.14);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(36, 62, 56, 0.06);
}

.service-logo-wrap {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f6fffb;
  border-radius: 24rpx;
}

.service-logo {
  width: 58rpx;
  height: 58rpx;
}

.service-copy {
  min-width: 0;
}

.service-title {
  color: #182E2A;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.service-subtitle {
  margin-top: 8rpx;
  color: #66736E;
  font-size: 23rpx;
  line-height: 1.35;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 24rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.avatar {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  border-radius: 20rpx;
}

.assistant-avatar {
  color: #182E2A;
  background: #C9A45D;
}

.user-avatar {
  color: #ffffff;
  background: #2E514A;
}

.message-main {
  max-width: calc(100% - 82rpx);
}

.message-row.user .message-main {
  display: flex;
  justify-content: flex-end;
}

.message-bubble {
  max-width: 100%;
  padding: 20rpx 22rpx;
  color: #182E2A;
  font-size: 25rpx;
  line-height: 1.55;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  box-shadow: 0 10rpx 24rpx rgba(36, 62, 56, 0.05);
}

.message-row.user .message-bubble {
  color: #ffffff;
  background: #2E514A;
  border-color: #2E514A;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
}

.degraded-notice {
  margin-top: 8rpx;
  color: #66736E;
  font-size: 21rpx;
  line-height: 1.35;
}

.need-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.need-tags text,
.guide-tags text {
  min-height: 42rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  color: #2E514A;
  font-size: 20rpx;
  font-weight: 900;
  background: #EDF3EF;
  border-radius: 14rpx;
}

.need-notice {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  color: #7A572D;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.4;
  background: #F6E9CE;
  border: 1rpx solid #DDC994;
  border-radius: 18rpx;
}

.guide-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.guide-tags text {
  color: #7A572D;
  background: #F1E4C8;
}

.empty-match {
  margin-top: 14rpx;
  padding: 20rpx;
  background: #F6E9CE;
  border: 1rpx solid #DDC994;
  border-radius: 22rpx;
}

.empty-title {
  color: #7A572D;
  font-size: 25rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8a6a2a;
  font-size: 22rpx;
  line-height: 1.42;
}

.retry-panel {
  margin-top: 12rpx;
}

.retry-panel button {
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 58rpx;
  background: #2E514A;
  border-radius: 18rpx;
}

.retry-panel button::after,
.refresh-recognize-button::after,
.confirm-match-button::after,
.feedback-button::after,
.card-actions button::after {
  border: 0;
}

.need-confirm-card {
  margin-top: 14rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(36, 62, 56, 0.05);
}

.confirm-card-title {
  color: #182E2A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.confirm-card-desc,
.confirm-source-label {
  margin-top: 8rpx;
  color: #66736E;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
}

.confirm-source-label {
  margin-top: 16rpx;
  color: #2E514A;
}

.confirm-source-textarea {
  width: 100%;
  min-height: 118rpx;
  margin-top: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
  color: #182E2A;
  font-size: 23rpx;
  line-height: 1.45;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 18rpx;
}

.refresh-recognize-button {
  height: 54rpx;
  margin: 12rpx 0 0;
  padding: 0 20rpx;
  color: #2E514A;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 54rpx;
  background: #EDF3EF;
  border-radius: 16rpx;
}

.editable-field-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}

.editable-field {
  min-width: 0;
  padding: 14rpx;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 16rpx;
}

.editable-field.wide {
  grid-column: 1 / -1;
}

.editable-field input {
  width: 100%;
  height: 54rpx;
  margin-top: 6rpx;
  color: #182E2A;
  font-size: 24rpx;
  font-weight: 900;
}

.confirm-field-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.confirm-field-list.compact {
  grid-template-columns: 1fr;
}

.confirm-field {
  min-width: 0;
  padding: 14rpx;
  background: #EEF3EF;
  border: 1rpx solid rgba(46, 81, 74, 0.1);
  border-radius: 16rpx;
}

.confirm-field.missing {
  background: #F6E9CE;
  border-color: #DDC994;
}

.confirm-field-label,
.confirm-field-value {
  display: block;
  min-width: 0;
}

.confirm-field-label {
  color: #66736E;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
}

.confirm-field-value {
  margin-top: 6rpx;
  color: #182E2A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.32;
  word-break: break-all;
}

.confirm-field.missing .confirm-field-value {
  color: #7A572D;
}

.confirm-match-button {
  height: 58rpx;
  margin: 16rpx 0 0;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 58rpx;
  background: #2E514A;
  border-radius: 18rpx;
}

.confirm-match-button[disabled] {
  opacity: 0.55;
}

.confirm-card-hint {
  margin-top: 14rpx;
  color: #8a6a2a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 16rpx;
}

.recommend-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-title {
  color: #2E514A;
  font-size: 23rpx;
  font-weight: 900;
}

.recommend-card {
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 32rpx rgba(36, 62, 56, 0.07);
}

.recommend-card.nearby {
  border-color: #f0d99a;
  background: #fffdf7;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  align-items: flex-start;
}

.card-title {
  min-width: 0;
  color: #182E2A;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.score-chip {
  flex: 0 0 auto;
  min-height: 46rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  color: #182E2A;
  font-size: 21rpx;
  font-weight: 900;
  background: #C9A45D;
  border-radius: 16rpx;
}

.card-meta,
.card-sub {
  margin-top: 8rpx;
  color: #66736E;
  font-size: 23rpx;
  line-height: 1.35;
}

.card-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.card-facts text {
  min-height: 42rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  color: #182E2A;
  font-size: 20rpx;
  font-weight: 900;
  background: #EEF3EF;
  border-radius: 14rpx;
}

.match-line,
.distance-line,
.diff-line {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  color: #62706B;
  font-size: 22rpx;
  line-height: 1.45;
}

.match-line text,
.distance-line text,
.diff-line text {
  flex: 0 0 auto;
  color: #2E514A;
  font-weight: 900;
}

.distance-line text {
  color: #2E514A;
}

.diff-line text {
  color: #7A572D;
}

.match-line view,
.distance-line view,
.diff-line view {
  min-width: 0;
  flex: 1;
}

.listing-feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.listing-feature-tag,
.listing-maintenance-tag {
  min-height: 38rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  color: #2E514A;
  font-size: 20rpx;
  font-weight: 800;
  background: #EDF3EF;
  border-radius: 14rpx;
}

.reason-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.reason-row text {
  min-height: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  color: #62706B;
  font-size: 20rpx;
  font-weight: 800;
  background: #F6F2EA;
  border-radius: 14rpx;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.card-price {
  color: #B9655A;
  font-size: 31rpx;
  font-weight: 900;
}

.card-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex-wrap: wrap;
}

.card-actions button {
  height: 50rpx;
  margin: 0;
  padding: 0 16rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 50rpx;
  color: #2E514A;
  background: #EDF3EF;
  border-radius: 16rpx;
}

.card-actions button:last-child {
  color: #ffffff;
  background: #2E514A;
}

.assistant-feedback {
  margin-top: 14rpx;
}

.feedback-actions {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.feedback-button {
  height: 48rpx;
  margin: 0;
  padding: 0 18rpx;
  color: #62706B;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 48rpx;
  background: #F6F2EA;
  border-radius: 16rpx;
}

.feedback-button.useful {
  color: #2E514A;
  background: #EDF3EF;
}

.feedback-button[disabled] {
  opacity: 0.6;
}

.feedback-done {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  padding: 0 14rpx;
  color: #66736E;
  font-size: 20rpx;
  font-weight: 800;
  background: #F6F2EA;
  border-radius: 14rpx;
}

.typing-bubble {
  width: 118rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
}

.typing-bubble view {
  width: 10rpx;
  height: 10rpx;
  background: #2E514A;
  border-radius: 999rpx;
  animation: typingDot 0.9s ease-in-out infinite;
}

.typing-bubble view:nth-child(2) {
  animation-delay: 0.12s;
}

.typing-bubble view:nth-child(3) {
  animation-delay: 0.24s;
}

.bottom-anchor {
  height: 2rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 251, 248, 0.94);
  border-top: 1rpx solid rgba(46, 81, 74, 0.12);
}

.composer-panel {
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 12rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 28rpx;
  box-shadow: 0 -10rpx 30rpx rgba(36, 62, 56, 0.07);
}

.chat-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 70rpx;
  padding: 0 18rpx;
  color: #182E2A;
  font-size: 25rpx;
  font-weight: 800;
  background: #F6F2EA;
  border-radius: 20rpx;
}

.chat-mic-button,
.send-button {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.chat-mic-button {
  flex: 0 0 82rpx;
}

.send-button {
  flex: 0 0 104rpx;
}

.chat-mic-button {
  position: relative;
  overflow: hidden;
  background: #C9A45D;
}

.chat-mic-button.active {
  background: #2E514A;
}

.chat-mic-button.disabled,
.send-button.disabled {
  opacity: 0.56;
}

.send-button {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  background: #2E514A;
}

/* ==== 微信式语音输入：语音/键盘切换 + 按住说话 + 录音浮层 ==== */
.voice-switch {
  position: relative;
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #C9A45D;
  flex-shrink: 0;
}
.voice-switch.busy,
.voice-switch.disabled {
  opacity: 0.56;
}
.kbd-icon {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  align-items: center;
}
.kbd-row {
  display: flex;
  gap: 5rpx;
}
.kbd-key {
  width: 9rpx;
  height: 9rpx;
  border-radius: 2rpx;
  background: #ffffff;
  opacity: 0.92;
}
.kbd-key.kbd-space {
  width: 33rpx;
}

.hold-to-talk {
  flex: 1 1 auto;
  min-width: 0;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F2EA;
  border-radius: 20rpx;
  color: #182E2A;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  transition: background 0.12s ease, color 0.12s ease;
}
.hold-to-talk.talking {
  background: #2E514A;
  color: #ffffff;
}
.hold-to-talk.cancel {
  background: linear-gradient(135deg, #d9584a 0%, #b33f33 100%);
  color: #ffffff;
}
.hold-to-talk.disabled {
  opacity: 0.56;
}
.hold-text {
  pointer-events: none;
}

.voice-rec-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 18, 16, 0.28);
}
.voice-rec-panel {
  width: 78vw;
  max-width: 560rpx;
  padding: 40rpx 36rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
}
.voice-rec-caption {
  min-height: 40rpx;
  max-height: 168rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  padding: 14rpx 22rpx;
  background: rgba(20, 34, 30, 0.9);
  border-radius: 18rpx;
}
.voice-rec-bubble {
  width: 220rpx;
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #315B51 0%, #223f38 100%);
  box-shadow: 0 14rpx 32rpx rgba(10, 24, 20, 0.3);
}
.voice-rec-bubble.cancel {
  background: linear-gradient(135deg, #d9584a 0%, #b33f33 100%);
}
.rec-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 70rpx;
}
.rec-wave .rw {
  width: 8rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  animation: voiceWave 0.82s ease-in-out infinite;
}
.rec-wave .b1 { animation-delay: 0s; }
.rec-wave .b2 { animation-delay: 0.12s; }
.rec-wave .b3 { animation-delay: 0.24s; }
.rec-wave .b4 { animation-delay: 0.36s; }
.rec-wave .b5 { animation-delay: 0.48s; }
.rec-cancel-x {
  position: relative;
  width: 56rpx;
  height: 56rpx;
}
.rec-cancel-x .x1,
.rec-cancel-x .x2 {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #ffffff;
}
.rec-cancel-x .x1 { transform: translate(-50%, -50%) rotate(45deg); }
.rec-cancel-x .x2 { transform: translate(-50%, -50%) rotate(-45deg); }
.voice-rec-hint {
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}
.voice-rec-hint.cancel {
  color: #ffd9d2;
}

.mic-icon {
  position: relative;
  z-index: 2;
  width: 40rpx;
  height: 50rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.mic-head {
  width: 22rpx;
  height: 32rpx;
  background: #182E2A;
  border-radius: 14rpx;
}

.mic-head::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 7rpx;
  height: 18rpx;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.55);
  border-radius: 8rpx;
}

.mic-neck {
  position: absolute;
  left: 50%;
  top: 30rpx;
  width: 24rpx;
  height: 14rpx;
  transform: translateX(-50%);
  border: 5rpx solid #182E2A;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
}

.mic-base {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 30rpx;
  height: 6rpx;
  transform: translateX(-50%);
  background: #182E2A;
  border-radius: 999rpx;
}

.mic-base::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 5rpx;
  width: 6rpx;
  height: 12rpx;
  transform: translateX(-50%);
  background: #182E2A;
  border-radius: 999rpx;
}

.chat-mic-button.active .mic-head,
.chat-mic-button.active .mic-base,
.chat-mic-button.active .mic-base::before {
  background: #ffffff;
}

.chat-mic-button.active .mic-neck {
  border-color: #ffffff;
}

.voice-wave {
  position: absolute;
  right: 7rpx;
  top: 50%;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 4rpx;
  transform: translateY(-50%);
  opacity: 0.82;
}

.wave-bar {
  width: 5rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 999rpx;
  animation: voiceWave 0.82s ease-in-out infinite;
}

.bar-1 {
  animation-delay: 0s;
}

.bar-2 {
  animation-delay: 0.12s;
}

.bar-3 {
  animation-delay: 0.24s;
}

@keyframes voiceWave {
  0%,
  100% {
    height: 12rpx;
    opacity: 0.58;
  }
  50% {
    height: 36rpx;
    opacity: 1;
  }
}

@keyframes typingDot {
  0%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-6rpx);
  }
}

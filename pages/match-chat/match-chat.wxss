page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f7fbf8;
}

.chat-page {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background:
    linear-gradient(180deg, #eef8f3 0%, #f7fbf8 320rpx, #f7fbf8 100%);
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.chat-shell {
  min-height: 100%;
  padding: 24rpx 28rpx 178rpx;
}

.service-head {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(47, 111, 96, 0.14);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 81, 68, 0.06);
}

.service-logo-wrap {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f6fffb;
  border-radius: 24rpx;
}

.service-logo {
  width: 58rpx;
  height: 58rpx;
}

.service-copy {
  min-width: 0;
}

.service-title {
  color: #153f36;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.service-subtitle {
  margin-top: 8rpx;
  color: #6f837c;
  font-size: 23rpx;
  line-height: 1.35;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 24rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.avatar {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  border-radius: 20rpx;
}

.assistant-avatar {
  color: #153f36;
  background: #f6bd36;
}

.user-avatar {
  color: #ffffff;
  background: #2f6f60;
}

.message-main {
  max-width: calc(100% - 82rpx);
}

.message-row.user .message-main {
  display: flex;
  justify-content: flex-end;
}

.message-bubble {
  max-width: 100%;
  padding: 20rpx 22rpx;
  color: #153f36;
  font-size: 25rpx;
  line-height: 1.55;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 81, 68, 0.05);
}

.message-row.user .message-bubble {
  color: #ffffff;
  background: #2f6f60;
  border-color: #2f6f60;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
}

.need-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.need-tags text,
.guide-tags text {
  min-height: 42rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  color: #2f6f60;
  font-size: 20rpx;
  font-weight: 900;
  background: #e9f5f0;
  border-radius: 14rpx;
}

.need-notice {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  color: #8a5b00;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.4;
  background: #fff8e6;
  border: 1rpx solid #f5df9c;
  border-radius: 18rpx;
}

.guide-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.guide-tags text {
  color: #8a5b00;
  background: #fff3cf;
}

.empty-match {
  margin-top: 14rpx;
  padding: 20rpx;
  background: #fff8e6;
  border: 1rpx solid #f5df9c;
  border-radius: 22rpx;
}

.empty-title {
  color: #8a5b00;
  font-size: 25rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8a6a2a;
  font-size: 22rpx;
  line-height: 1.42;
}

.retry-panel {
  margin-top: 12rpx;
}

.retry-panel button {
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 58rpx;
  background: #2f6f60;
  border-radius: 18rpx;
}

.retry-panel button::after,
.refresh-recognize-button::after,
.confirm-match-button::after,
.card-actions button::after {
  border: 0;
}

.need-confirm-card {
  margin-top: 14rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 81, 68, 0.05);
}

.confirm-card-title {
  color: #153f36;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.confirm-card-desc,
.confirm-source-label {
  margin-top: 8rpx;
  color: #6f837c;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
}

.confirm-source-label {
  margin-top: 16rpx;
  color: #2f6f60;
}

.confirm-source-textarea {
  width: 100%;
  min-height: 118rpx;
  margin-top: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
  color: #153f36;
  font-size: 23rpx;
  line-height: 1.45;
  background: #f7fbf8;
  border: 1rpx solid #dce9e3;
  border-radius: 18rpx;
}

.refresh-recognize-button {
  height: 54rpx;
  margin: 12rpx 0 0;
  padding: 0 20rpx;
  color: #2f6f60;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 54rpx;
  background: #e9f5f0;
  border-radius: 16rpx;
}

.editable-field-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}

.editable-field {
  min-width: 0;
  padding: 14rpx;
  background: #f7fbf8;
  border: 1rpx solid #dce9e3;
  border-radius: 16rpx;
}

.editable-field.wide {
  grid-column: 1 / -1;
}

.editable-field input {
  width: 100%;
  height: 54rpx;
  margin-top: 6rpx;
  color: #153f36;
  font-size: 24rpx;
  font-weight: 900;
}

.confirm-field-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 14rpx;
}

.confirm-field-list.compact {
  grid-template-columns: 1fr;
}

.confirm-field {
  min-width: 0;
  padding: 14rpx;
  background: #eef8f3;
  border: 1rpx solid rgba(47, 111, 96, 0.1);
  border-radius: 16rpx;
}

.confirm-field.missing {
  background: #fff8e6;
  border-color: #f5df9c;
}

.confirm-field-label,
.confirm-field-value {
  display: block;
  min-width: 0;
}

.confirm-field-label {
  color: #6f837c;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.25;
}

.confirm-field-value {
  margin-top: 6rpx;
  color: #153f36;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.32;
  word-break: break-all;
}

.confirm-field.missing .confirm-field-value {
  color: #8a5b00;
}

.confirm-match-button {
  height: 58rpx;
  margin: 16rpx 0 0;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 58rpx;
  background: #2f6f60;
  border-radius: 18rpx;
}

.confirm-match-button[disabled] {
  opacity: 0.55;
}

.confirm-card-hint {
  margin-top: 14rpx;
  color: #8a6a2a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 16rpx;
}

.recommend-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-title {
  color: #2f6f60;
  font-size: 23rpx;
  font-weight: 900;
}

.recommend-card {
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 32rpx rgba(31, 81, 68, 0.07);
}

.recommend-card.nearby {
  border-color: #f0d99a;
  background: #fffdf7;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  align-items: flex-start;
}

.card-title {
  min-width: 0;
  color: #153f36;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.score-chip {
  flex: 0 0 auto;
  min-height: 46rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  color: #153f36;
  font-size: 21rpx;
  font-weight: 900;
  background: #f6bd36;
  border-radius: 16rpx;
}

.card-meta,
.card-sub {
  margin-top: 8rpx;
  color: #6f837c;
  font-size: 23rpx;
  line-height: 1.35;
}

.card-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.card-facts text {
  min-height: 42rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  color: #153f36;
  font-size: 20rpx;
  font-weight: 900;
  background: #eef8f3;
  border-radius: 14rpx;
}

.match-line,
.diff-line {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  color: #4f675f;
  font-size: 22rpx;
  line-height: 1.45;
}

.match-line text,
.diff-line text {
  flex: 0 0 auto;
  color: #2f6f60;
  font-weight: 900;
}

.diff-line text {
  color: #8a5b00;
}

.match-line view,
.diff-line view {
  min-width: 0;
  flex: 1;
}

.listing-feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.listing-feature-tag,
.listing-maintenance-tag {
  min-height: 38rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  color: #2f6f60;
  font-size: 20rpx;
  font-weight: 800;
  background: #e9f5f0;
  border-radius: 14rpx;
}

.reason-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.reason-row text {
  min-height: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  color: #4f675f;
  font-size: 20rpx;
  font-weight: 800;
  background: #f7fbf8;
  border-radius: 14rpx;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.card-price {
  color: #f2765d;
  font-size: 31rpx;
  font-weight: 900;
}

.card-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex-wrap: wrap;
}

.card-actions button {
  height: 50rpx;
  margin: 0;
  padding: 0 16rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 50rpx;
  color: #2f6f60;
  background: #e9f5f0;
  border-radius: 16rpx;
}

.card-actions button:last-child {
  color: #ffffff;
  background: #2f6f60;
}

.typing-bubble {
  width: 118rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
}

.typing-bubble view {
  width: 10rpx;
  height: 10rpx;
  background: #2f6f60;
  border-radius: 999rpx;
  animation: typingDot 0.9s ease-in-out infinite;
}

.typing-bubble view:nth-child(2) {
  animation-delay: 0.12s;
}

.typing-bubble view:nth-child(3) {
  animation-delay: 0.24s;
}

.bottom-anchor {
  height: 2rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 251, 248, 0.94);
  border-top: 1rpx solid rgba(47, 111, 96, 0.12);
}

.composer-panel {
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 28rpx;
  box-shadow: 0 -10rpx 30rpx rgba(31, 81, 68, 0.07);
}

.chat-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 70rpx;
  padding: 0 18rpx;
  color: #153f36;
  font-size: 25rpx;
  font-weight: 800;
  background: #f7fbf8;
  border-radius: 20rpx;
}

.chat-mic-button,
.send-button {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.chat-mic-button {
  flex: 0 0 82rpx;
}

.send-button {
  flex: 0 0 104rpx;
}

.chat-mic-button {
  position: relative;
  overflow: hidden;
  background: #f6bd36;
}

.chat-mic-button.active {
  background: #2f6f60;
}

.chat-mic-button.disabled,
.send-button.disabled {
  opacity: 0.56;
}

.send-button {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  background: #2f6f60;
}

.mic-icon {
  position: relative;
  z-index: 2;
  width: 40rpx;
  height: 50rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.mic-head {
  width: 22rpx;
  height: 32rpx;
  background: #153f36;
  border-radius: 14rpx;
}

.mic-head::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 7rpx;
  height: 18rpx;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.55);
  border-radius: 8rpx;
}

.mic-neck {
  position: absolute;
  left: 50%;
  top: 30rpx;
  width: 24rpx;
  height: 14rpx;
  transform: translateX(-50%);
  border: 5rpx solid #153f36;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
}

.mic-base {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 30rpx;
  height: 6rpx;
  transform: translateX(-50%);
  background: #153f36;
  border-radius: 999rpx;
}

.mic-base::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 5rpx;
  width: 6rpx;
  height: 12rpx;
  transform: translateX(-50%);
  background: #153f36;
  border-radius: 999rpx;
}

.chat-mic-button.active .mic-head,
.chat-mic-button.active .mic-base,
.chat-mic-button.active .mic-base::before {
  background: #ffffff;
}

.chat-mic-button.active .mic-neck {
  border-color: #ffffff;
}

.voice-wave {
  position: absolute;
  right: 7rpx;
  top: 50%;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 4rpx;
  transform: translateY(-50%);
  opacity: 0.82;
}

.wave-bar {
  width: 5rpx;
  height: 16rpx;
  background: #ffffff;
  border-radius: 999rpx;
  animation: voiceWave 0.82s ease-in-out infinite;
}

.bar-1 {
  animation-delay: 0s;
}

.bar-2 {
  animation-delay: 0.12s;
}

.bar-3 {
  animation-delay: 0.24s;
}

@keyframes voiceWave {
  0%,
  100% {
    height: 12rpx;
    opacity: 0.58;
  }
  50% {
    height: 36rpx;
    opacity: 1;
  }
}

@keyframes typingDot {
  0%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-6rpx);
  }
}

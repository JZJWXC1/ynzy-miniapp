<navigation-bar title="找房助手" back="{{true}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<view class="chat-page">
  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollTarget}}" type="list">
    <view class="chat-shell">
      <view class="service-head">
        <view class="service-logo-wrap">
          <image class="service-logo" src="/assets/logo.png" mode="aspectFit"></image>
        </view>
        <view class="service-copy">
          <view class="service-title">智能找房助手</view>
          <view class="service-subtitle">一句话匹配真实可租房源</view>
        </view>
      </view>

      <view wx:for="{{messages}}" wx:for-item="message" wx:key="id" id="{{message.id}}" class="message-row {{message.role}}">
        <view wx:if="{{message.role === 'assistant'}}" class="avatar assistant-avatar">寓</view>
        <view class="message-main">
          <view class="message-bubble">
            <text>{{message.text}}</text>
          </view>
          <view wx:if="{{message.degradedNotice}}" class="degraded-notice">{{message.degradedNotice}}</view>

          <view wx:if="{{message.retryable}}" class="retry-panel">
            <button loading="{{loading}}" bindtap="retryLastNeed">{{message.retryText || '重试'}}</button>
          </view>

          <view wx:if="{{message.canEditConfirmation}}" class="need-confirm-card">
            <view class="confirm-card-title">确认找房字段</view>
            <view class="confirm-card-desc">{{message.confirmHint}}</view>
            <view class="confirm-source-label">{{message.sourceLabel || '输入文本'}}</view>
            <textarea
              class="confirm-source-textarea"
              value="{{message.confirmText}}"
              bindinput="handleConfirmTextInput"
              data-message-id="{{message.id}}"
              maxlength="260"
              placeholder="可修正已转写或重写后的需求文本"
            ></textarea>
            <button
              class="refresh-recognize-button"
              loading="{{loading}}"
              bindtap="recognizeEditedTextFromMessage"
              data-message-id="{{message.id}}"
            >
              按修正文本重新识别
            </button>
            <view class="editable-field-list">
              <view class="editable-field">
                <text class="confirm-field-label">预算</text>
                <input value="{{message.confirmForm.budget}}" bindinput="handleConfirmFieldInput" data-message-id="{{message.id}}" data-field="budget" placeholder="如 3000 或 3000-4000" />
              </view>
              <view class="editable-field">
                <text class="confirm-field-label">区域</text>
                <input value="{{message.confirmForm.area}}" bindinput="handleConfirmFieldInput" data-message-id="{{message.id}}" data-field="area" placeholder="如 滨江" />
              </view>
              <view class="editable-field">
                <text class="confirm-field-label">小区/板块</text>
                <input value="{{message.confirmForm.community}}" bindinput="handleConfirmFieldInput" data-message-id="{{message.id}}" data-field="community" placeholder="如 东新园" />
              </view>
              <view class="editable-field">
                <text class="confirm-field-label">租法</text>
                <input value="{{message.confirmForm.rentMode}}" bindinput="handleConfirmFieldInput" data-message-id="{{message.id}}" data-field="rentMode" placeholder="整租/合租" />
              </view>
              <view class="editable-field">
                <text class="confirm-field-label">户型</text>
                <input value="{{message.confirmForm.layout}}" bindinput="handleConfirmFieldInput" data-message-id="{{message.id}}" data-field="layout" placeholder="如 两室/单间" />
              </view>
              <view class="editable-field wide">
                <text class="confirm-field-label">标签/偏好</text>
                <input value="{{message.confirmForm.featuresText}}" bindinput="handleConfirmFieldInput" data-message-id="{{message.id}}" data-field="featuresText" placeholder="近地铁、燃气、带阳台" />
              </view>
            </view>
            <view wx:if="{{message.needFields && message.needFields.length}}" class="confirm-field-list compact">
              <view
                wx:for="{{message.needFields}}"
                wx:for-item="field"
                wx:key="key"
                class="confirm-field {{field.filled ? '' : 'missing'}}"
              >
                <text class="confirm-field-label">{{field.label}}</text>
                <text class="confirm-field-value">{{field.value}}</text>
              </view>
            </view>
            <button
              class="confirm-match-button"
              disabled="{{!message.canConfirm || loading}}"
              loading="{{loading}}"
              bindtap="confirmNeedFromMessage"
              data-message-id="{{message.id}}"
            >
              确认并匹配
            </button>
            <view wx:if="{{!message.canConfirm}}" class="confirm-card-hint">字段不足时，我会继续追问一个关键问题。</view>
          </view>

          <view wx:if="{{message.needTags && message.needTags.length}}" class="need-tags">
            <text wx:for="{{message.needTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>

          <view wx:if="{{message.needNotice}}" class="need-notice">{{message.needNotice}}</view>

          <view wx:if="{{message.empty}}" class="empty-match">
            <view class="empty-title">暂无合适房源</view>
            <view class="empty-desc">可以放宽预算、区域或户型后再试。</view>
          </view>

          <view wx:if="{{message.listingSections && message.listingSections.length}}" class="recommend-list">
            <view wx:for="{{message.listingSections}}" wx:for-item="section" wx:key="title" class="recommend-section">
              <view class="section-title">{{section.title}}</view>
              <view
                wx:for="{{section.listings}}"
                wx:for-item="listing"
                wx:key="id"
                class="recommend-card {{listing.matchGroup === 'nearby' ? 'nearby' : ''}}"
              >
                <view class="card-head">
                  <view class="card-title">{{listing.cardTitle}}</view>
                  <view class="card-head-actions">
                    <view wx:if="{{listing.displayRelevance}}" class="score-chip">
                      {{listing.displayRelevance}}
                    </view>
                    <favorite-toggle listing-id="{{listing.id}}" compact></favorite-toggle>
                  </view>
                </view>
                <view class="card-facts">
                  <text>{{listing.price || '租金待补充'}}</text>
                  <text>{{listing.community || '小区待补充'}}</text>
                  <text>{{listing.layout || '户型待补充'}}</text>
                  <text wx:if="{{listing.maintenanceText}}">{{listing.maintenanceText}}</text>
                </view>
                <view wx:if="{{listing.matchReason}}" class="match-line">
                  <text>理由</text>
                  <view>{{listing.matchReason}}</view>
                </view>
                <view wx:if="{{listing.distanceText}}" class="distance-line">
                  <text>距离</text>
                  <view>{{listing.distanceText}}</view>
                </view>
                <view wx:if="{{listing.differenceText}}" class="diff-line">
                  <text>差异</text>
                  <view>{{listing.differenceText}}</view>
                </view>
                <view wx:if="{{listing.features && listing.features.length}}" class="listing-feature-row">
                  <text wx:for="{{listing.features}}" wx:for-item="feature" wx:key="*this" class="listing-feature-tag">{{feature}}</text>
                </view>
                <view class="card-bottom">
                  <view class="card-price">{{listing.price}}</view>
                  <view class="card-actions">
                    <button catchtap="openListing" data-id="{{listing.id}}" data-need-id="{{message.needId}}">看详情</button>
                    <button catchtap="openMapForListing" data-id="{{listing.id}}" data-message-id="{{message.id}}">地图查看</button>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view wx:if="{{message.canFeedback}}" class="assistant-feedback">
            <view wx:if="{{!message.feedbackSent}}">
              <view class="feedback-actions">
                <button
                  class="feedback-button useful {{message.feedbackType === 'helpful' ? 'selected' : ''}}"
                  size="mini"
                  disabled="{{message.feedbackLoading}}"
                  catchtap="selectAssistantFeedbackType"
                  data-message-id="{{message.id}}"
                  data-type="helpful"
                >
                  有用
                </button>
                <button
                  class="feedback-button {{message.feedbackType === 'bad_recommendation' ? 'selected' : ''}}"
                  size="mini"
                  disabled="{{message.feedbackLoading}}"
                  catchtap="selectAssistantFeedbackType"
                  data-message-id="{{message.id}}"
                  data-type="bad_recommendation"
                >
                  没用
                </button>
              </view>
              <view wx:if="{{message.feedbackType}}" class="feedback-reasons">
                <view class="feedback-reason-title">主要原因</view>
                <view class="feedback-reason-list">
                  <button
                    wx:for="{{message.feedbackReasonOptions}}"
                    wx:key="code"
                    class="feedback-reason-button {{message.feedbackReasonCode === item.code ? 'selected' : ''}}"
                    size="mini"
                    loading="{{message.feedbackLoading && message.feedbackReasonCode === item.code}}"
                    disabled="{{message.feedbackLoading}}"
                    catchtap="submitAssistantFeedback"
                    data-message-id="{{message.id}}"
                    data-reason-code="{{item.code}}"
                  >
                    {{item.label}}
                  </button>
                </view>
              </view>
            </view>
            <view wx:else class="feedback-done">已收到反馈 · {{message.feedbackReasonLabel}}</view>
          </view>
        </view>
        <view wx:if="{{message.role === 'user'}}" class="avatar user-avatar">我</view>
      </view>

      <view wx:if="{{loading}}" id="typing-row" class="message-row assistant">
        <view class="avatar assistant-avatar">寓</view>
        <view class="message-main">
          <view class="typing-bubble">
            <view></view>
            <view></view>
            <view></view>
          </view>
        </view>
      </view>
      <view id="bottom-anchor" class="bottom-anchor"></view>
    </view>
  </scroll-view>

  <view class="composer">
    <view class="composer-panel">
      <!-- 语音/键盘切换（仿微信）：键盘态显麦克风(点→语音)、语音态显键盘(点→文字) -->
      <view class="voice-switch {{voicePhase ? 'busy' : ''}} {{loading ? 'disabled' : ''}}" bindtap="toggleVoiceMode" aria-role="button" aria-label="{{voiceMode ? '切换到键盘输入' : '切换到语音输入'}}">
        <view wx:if="{{!voiceMode}}" class="mic-icon">
          <view class="mic-head"></view>
          <view class="mic-neck"></view>
          <view class="mic-base"></view>
        </view>
        <view wx:else class="kbd-icon">
          <view class="kbd-row"><view class="kbd-key"></view><view class="kbd-key"></view><view class="kbd-key"></view></view>
          <view class="kbd-row"><view class="kbd-key"></view><view class="kbd-key"></view><view class="kbd-key"></view></view>
          <view class="kbd-row"><view class="kbd-key kbd-space"></view></view>
        </view>
      </view>
      <!-- 键盘模式：文本输入 -->
      <input
        wx:if="{{!voiceMode}}"
        class="chat-input"
        value="{{inputText}}"
        bindinput="handleInput"
        bindconfirm="sendMessage"
        confirm-type="send"
        disabled="{{loading}}"
        placeholder="说一句客户预算、区域和户型"
      />
      <!-- 语音模式：按住说话 -->
      <view
        wx:else
        class="hold-to-talk {{voicePhase === 'recording' ? (voiceCancelActive ? 'cancel' : 'talking') : ''}} {{loading ? 'disabled' : ''}}"
        bindtouchstart="onVoiceTouchStart"
        catchtouchmove="onVoiceTouchMove"
        bindtouchend="onVoiceTouchEnd"
        bindtouchcancel="onVoiceTouchCancel"
        aria-role="button"
      >
        <text class="hold-text">{{loading ? '匹配中…' : (voicePhase === 'recording' ? '松开 结束' : '按住 说话')}}</text>
      </view>
      <view class="send-button {{loading ? 'disabled' : ''}}" bindtap="sendMessage" aria-role="button">{{loading ? '匹配中' : '找房'}}</view>
    </view>
  </view>

  <!-- 语音录音浮层（仿微信：按住说话时全屏，上滑进入取消态） -->
  <view wx:if="{{voicePhase}}" class="voice-rec-mask" catchtouchmove="noop">
    <view class="voice-rec-panel {{voiceCancelActive ? 'cancel' : ''}}">
      <view class="voice-rec-caption">{{voiceText ? voiceText : (voicePhase === 'transcribing' ? '识别中…' : '正在听，请说…')}}</view>
      <view class="voice-rec-bubble {{voiceCancelActive ? 'cancel' : ''}}">
        <block wx:if="{{!voiceCancelActive}}">
          <view class="rec-wave">
            <view class="rw b1"></view>
            <view class="rw b2"></view>
            <view class="rw b3"></view>
            <view class="rw b4"></view>
            <view class="rw b5"></view>
          </view>
        </block>
        <view wx:else class="rec-cancel-x"><view class="x1"></view><view class="x2"></view></view>
      </view>
      <view class="voice-rec-hint {{voiceCancelActive ? 'cancel' : ''}}">{{voiceCancelActive ? '松开手指，取消发送' : '手指上滑，取消发送'}}</view>
    </view>
  </view>
</view>

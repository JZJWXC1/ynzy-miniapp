<navigation-bar title="{{category}}房源" back="{{false}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell listings-page">
    <view class="category-tabs">
      <view wx:for="{{categories}}" wx:key="*this" class="category-tab {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="switchCategory">{{item}}</view>
    </view>

    <view class="filter-panel">
      <view class="filter-section">
        <view class="filter-segment-label">区域</view>
        <view class="region-tabs">
          <view class="region-tab {{!filters.area ? 'active' : ''}}" data-area="" bindtap="selectArea">不限</view>
          <view
            wx:for="{{regionOptions}}"
            wx:key="name"
            class="region-tab {{filters.area === item.name ? 'active' : ''}}"
            data-area="{{item.name}}"
            bindtap="selectArea"
          >{{item.name}}</view>
        </view>
      </view>
      <view wx:if="{{blockOptions.length}}" class="filter-section">
        <view class="filter-segment-label">板块</view>
        <view class="block-tabs">
          <view class="block-tab {{!filters.block ? 'active' : ''}}" data-block="" bindtap="selectBlock">不限</view>
          <view
            wx:for="{{blockOptions}}"
            wx:key="*this"
            class="block-tab {{filters.block === item ? 'active' : ''}}"
            data-block="{{item}}"
            bindtap="selectBlock"
          >{{item}}</view>
        </view>
      </view>
      <view class="filter-grid">
        <input value="{{filters.community}}" data-field="community" bindinput="updateFilter" placeholder="小区名称" />
        <input value="{{filters.layout}}" data-field="layout" bindinput="updateFilter" placeholder="户型" />
        <input value="{{filters.rentMin}}" data-field="rentMin" bindinput="updateFilter" type="number" placeholder="最低租金" />
        <input value="{{filters.rentMax}}" data-field="rentMax" bindinput="updateFilter" type="number" placeholder="最高租金" />
      </view>
      <view class="filter-segment">
        <text class="filter-segment-label">租赁方式</text>
        <view class="rent-mode-tabs">
          <view
            wx:for="{{rentModeFilters}}"
            wx:key="*this"
            class="rent-mode-tab {{(!filters.rentMode && item === '不限') || filters.rentMode === item ? 'active' : ''}}"
            data-mode="{{item}}"
            bindtap="switchRentMode"
          >{{item}}</view>
        </view>
      </view>
      <view class="filter-actions">
        <button class="filter-button primary" loading="{{loading}}" bindtap="applyFilters">筛选</button>
        <button class="filter-button ghost" bindtap="resetFilters">重置</button>
      </view>
    </view>

    <view class="list-summary">
      <view>{{category}} · {{listings.length}} 套</view>
      <view>实名查看留痕 · 视频房源</view>
    </view>

    <view wx:if="{{listings.length}}" class="listing-list">
      <view wx:for="{{listings}}" wx:key="id" class="listing-card soft-card" data-id="{{item.id}}" bindtap="openListing">
        <view class="listing-media">
          <view class="video-badge">视频</view>
          <view class="media-window"></view>
        </view>
        <view class="listing-body">
          <view class="listing-title-row">
            <text wx:if="{{item.rentMode === '整租'}}" class="rent-mode-badge">整</text>
            <text class="listing-title">{{item.title}}</text>
          </view>
          <view class="listing-meta">{{item.locationSummary || item.community}} · {{item.roomAddress || item.roomNumber}}</view>
          <view class="listing-sub">{{item.layout}} · {{item.sourceLabel || item.source}} · {{item.status}}</view>
          <view wx:if="{{item.features}}" class="listing-feature-row">
            <text wx:for="{{item.features}}" wx:key="*this" class="listing-feature-tag">{{item}}</text>
            <text wx:if="{{item.maintenanceText}}" class="listing-maintenance-tag">{{item.maintenanceText}}</text>
          </view>
          <view class="listing-bottom">
            <view class="price">{{item.price}}</view>
            <view class="commission">{{item.tag}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-card">
      <view class="empty-title">{{emptyText}}</view>
      <view class="empty-desc">可以调整区域、户型或租金条件后重新筛选。</view>
    </view>
  </view>
</scroll-view>

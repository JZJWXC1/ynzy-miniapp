<navigation-bar title="{{category === '全部' ? '全部房源' : category}}" back="{{false}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell listings-page">
    <view class="category-tabs">
      <view wx:for="{{categories}}" wx:key="*this" class="category-tab {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="switchCategory">{{item}}</view>
    </view>

    <listing-filter
      filters="{{filters}}"
      region-options="{{regionOptions}}"
      community-options="{{communityOptions}}"
      layout-options="{{layoutOptions}}"
      feature-options="{{featureOptions}}"
      loading="{{loading}}"
      bind:filterchange="handleListingFilterChange"
      bind:filterapply="handleListingFilterApply"
      bind:filterreset="resetFilters"
    ></listing-filter>

    <view class="list-summary">
      <view class="list-summary-count">{{loadFailed ? '刷新失败，当前为上次结果' : (category + ' · ' + listings.length + ' 套')}}</view>
      <view class="list-summary-note">合作敏感信息需留痕 · 有视频可预览</view>
    </view>

    <view wx:if="{{loadFailed}}" class="empty-card">
      <view class="empty-title">房源加载失败</view>
      <view class="empty-desc">已保留上次结果，请检查网络后重试。</view>
      <button class="brand-button" bindtap="retryListings">重新加载</button>
    </view>

    <view wx:if="{{listings.length}}" class="listing-list">
      <view wx:for="{{listings}}" wx:key="id" class="listing-card soft-card" data-id="{{item.id}}" bindtap="openListing">
        <view class="listing-media">
          <view class="listing-favorite"><favorite-toggle listing-id="{{item.id}}" compact></favorite-toggle></view>
          <image wx:if="{{item.coverUrl}}" class="listing-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load data-id="{{item.id}}" data-cover="{{item.coverUrl}}" binderror="onCoverError"></image>
          <view wx:elif="{{item.hasVideo}}" class="media-empty-state media-video-pending">
            <text class="media-empty-mark">影</text>
            <text class="media-empty-label">点开播放</text>
          </view>
          <view wx:else class="media-empty-state">
            <text class="media-empty-mark">—</text>
            <text class="media-empty-label">暂无视频</text>
          </view>
          <view wx:if="{{item.hasVideo}}" class="video-badge">视频</view>
        </view>
        <view class="listing-body">
          <view class="listing-title-row">
            <text wx:if="{{item.rentMode === '整租'}}" class="rent-mode-badge">整</text>
            <text class="listing-title">{{item.title}}</text>
          </view>
          <view wx:if="{{item.listingMetaText}}" class="listing-meta">{{item.listingMetaText}}</view>
          <view wx:if="{{item.listingSubText}}" class="listing-sub">{{item.listingSubText}}</view>
          <view wx:if="{{item.features}}" class="listing-feature-row">
            <text wx:for="{{item.features}}" wx:key="*this" class="listing-feature-tag">{{item}}</text>
            <text wx:if="{{item.maintenanceText}}" class="listing-maintenance-tag">{{item.maintenanceText}}</text>
          </view>
          <view class="listing-bottom">
            <view class="price">{{item.price}}</view>
            <view class="commission">{{item.tag}}</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:elif="{{loading}}" class="empty-card">
      <view class="empty-title">正在加载房源</view>
    </view>

    <view wx:elif="{{!loading && !loadFailed}}" class="empty-card">
      <view class="empty-title">{{emptyText}}</view>
      <view class="empty-desc">可以调整区域、户型或租金条件后重新筛选。</view>
    </view>
  </view>
</scroll-view>

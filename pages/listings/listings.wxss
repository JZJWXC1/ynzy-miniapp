.page-scroll {
  height: 100vh;
  background: #F6F2EA;
}

.listings-page {
  padding: 24rpx 24rpx 150rpx;
}

.category-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.category-tab {
  flex: 1 1 120rpx;
  min-width: 0;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2E514A;
  font-size: 24rpx;
  font-weight: 900;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 18rpx;
}

.category-tab.active {
  color: #182E2A;
  background: #C9A45D;
  border-color: #C9A45D;
}

.filter-panel {
  margin-top: 18rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 28rpx rgba(36, 62, 56, 0.06);
}

.filter-section {
  margin-bottom: 16rpx;
}

.region-tabs,
.block-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.region-tab,
.block-tab {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  color: #2E514A;
  font-size: 23rpx;
  font-weight: 900;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 16rpx;
}

.region-tab.active,
.block-tab.active {
  color: #ffffff;
  background: #2E514A;
  border-color: #2E514A;
}

.filter-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.filter-grid input {
  flex: 1 1 210rpx;
  min-width: 0;
  height: 70rpx;
  padding: 0 18rpx;
  color: #182E2A;
  font-size: 24rpx;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 18rpx;
}

.filter-segment {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.filter-segment-label {
  flex: 0 0 auto;
  color: #182E2A;
  font-size: 24rpx;
  font-weight: 900;
}

.rent-mode-tabs {
  min-width: 0;
  display: flex;
  flex: 1 1 auto;
  gap: 10rpx;
}

.rent-mode-tab {
  flex: 1 1 0;
  min-width: 0;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2E514A;
  font-size: 23rpx;
  font-weight: 900;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 16rpx;
}

.rent-mode-tab.active {
  color: #ffffff;
  background: #2E514A;
  border-color: #2E514A;
}

.filter-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.filter-button {
  flex: 1 1 0;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  font-weight: 900;
  border-radius: 20rpx;
}

.filter-button.primary {
  color: #ffffff;
  background: #2E514A;
}

.filter-button.ghost {
  color: #2E514A;
  background: #EDF3EF;
}

.list-summary {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #6A7671;
  font-size: 23rpx;
  font-weight: 900;
}

.listing-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.listing-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 18rpx;
}

.listing-media {
  flex: 0 0 190rpx;
  min-height: 168rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #E3EFED, #F2E5C8);
  border-radius: 18rpx;
}

.media-window {
  position: absolute;
  inset: 42rpx 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(46, 81, 74, 0.18);
  border-radius: 16rpx;
}

.video-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  z-index: 1;
  padding: 6rpx 12rpx;
  color: #182E2A;
  font-size: 20rpx;
  font-weight: 900;
  background: #C9A45D;
  border-radius: 999rpx;
}

.listing-body {
  min-width: 0;
}

.listing-title-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.rent-mode-badge {
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  background: #A94F45;
  border-radius: 6rpx;
}

.listing-title {
  min-width: 0;
  color: #182E2A;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.28;
}

.listing-meta,
.listing-sub {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 23rpx;
  line-height: 1.35;
}

.listing-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.price {
  color: #182E2A;
  font-size: 30rpx;
  font-weight: 900;
}

.commission {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  color: #2E514A;
  font-size: 21rpx;
  font-weight: 900;
  background: #EDF3EF;
  border-radius: 999rpx;
}

.empty-card {
  margin-top: 24rpx;
  padding: 40rpx 24rpx;
  color: #6A7671;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 24rpx;
}

.empty-title {
  color: #182E2A;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
}

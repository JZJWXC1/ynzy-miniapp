page {
  background: #f4f8f5;
  color: #183c34;
}

.page-scroll {
  height: 100vh;
}

.page-shell {
  box-sizing: border-box;
  /* 底部叠加安全区内边距：全面屏 home indicator 机型下末条收藏不被遮挡（非刘海机型 env 为 0）。 */
  padding: 28rpx 28rpx calc(72rpx + env(safe-area-inset-bottom));
}

.favorite-hero,
.favorite-card,
.empty-card {
  border: 1rpx solid #dbe8e1;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(31, 77, 65, 0.07);
}

.favorite-hero {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #eaf5ef, #fffaf0);
}

.hero-title {
  font-size: 32rpx;
  font-weight: 800;
}

.hero-sub,
.card-meta,
.empty-desc {
  margin-top: 10rpx;
  color: #6c7d77;
  font-size: 23rpx;
  line-height: 1.6;
}

.filter-label {
  margin: 22rpx 0 12rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
}

.status-row {
  display: flex;
}

.filter-chip {
  width: auto;
  min-width: 144rpx;
  height: 62rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid #d7e3dd;
  border-radius: 999rpx;
  background: #fff;
  color: #547067;
  font-size: 23rpx;
  line-height: 60rpx;
}

.filter-chip::after {
  border: 0;
}

.filter-chip.active {
  border-color: #2f6f60;
  background: #2f6f60;
  color: #fff;
}

.favorite-summary {
  margin: 22rpx 4rpx 14rpx;
  color: #71817b;
  font-size: 22rpx;
}

.favorite-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.favorite-card.unavailable {
  border-color: #d8d8d4;
  background: #f1f1ee;
  box-shadow: none;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-copy {
  min-width: 0;
  flex: 1;
}

.card-title {
  font-size: 29rpx;
  font-weight: 900;
}

.favorite-cover {
  width: 100%;
  height: 260rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
}

.unavailable-banner {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #e5e5e1;
  color: #777872;
  font-size: 23rpx;
}

.card-facts,
.feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.card-facts text,
.feature-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #edf5f1;
  color: #35695b;
  font-size: 21rpx;
}

.feature-chip {
  background: #fff6df;
  color: #87641f;
}

.empty-card {
  padding: 40rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 800;
}

.brand-button {
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #2f6f60;
  color: #fff;
}

<!--profile.wxml-->
<navigation-bar title="我的" back="{{false}}" color="#2E6B4E" background="#FBF5EA"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell profile-page">
    <view class="user-card">
      <view class="avatar-wrap">
        <image class="avatar-logo" src="/assets/logo.png" mode="aspectFit"></image>
      </view>
      <view class="user-info">
        <view class="user-name">{{user.name}}</view>
        <view class="user-role">{{user.role}}</view>
        <view class="auth-tag">{{user.authed}}</view>
      </view>
      <view class="account-actions">
        <button class="login-button" bindtap="handleTap" data-name="登录注册" data-url="/pages/auth/auth">切换账号</button>
        <button wx:if="{{user.id}}" class="logout-button" bindtap="logout">退出登录</button>
      </view>
    </view>

    <view class="source-stats">
      <view wx:for="{{sourceStats}}" wx:key="label" class="source-stat">
        <view class="source-value">{{item.value}}</view>
        <view class="source-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section-title">
      <view class="section-title-main">内部工作台</view>
    </view>

    <view class="workbench-grid">
      <button wx:for="{{workbench}}" wx:key="title" class="workbench-card" bindtap="handleTap" data-name="{{item.title}}" data-url="{{item.url}}">
        <view class="workbench-head">
          <view class="workbench-title">{{item.title}}</view>
          <view class="workbench-value">{{item.value}}</view>
        </view>
      </button>
    </view>

    <view class="section-title">
      <view class="section-title-main">报备签单</view>
    </view>

    <view class="deal-grid">
      <button wx:for="{{dealWorkbench}}" wx:key="title" class="deal-card" bindtap="handleTap" data-name="{{item.title}}" data-url="{{item.url}}">
        <view class="deal-title">{{item.title}}</view>
        <view class="deal-desc">{{item.desc}}</view>
        <view class="deal-status">{{item.status}}</view>
      </button>
    </view>

    <view class="section-title">
      <view class="section-title-main">今日工作台</view>
      <button class="section-title-action" bindtap="handleTap" data-name="查看全部提醒">全部</button>
    </view>

    <view class="reminder-list">
      <view wx:for="{{reminders}}" wx:key="title" class="reminder-card soft-card">
        <view class="reminder-dot"></view>
        <view>
          <view class="reminder-title">{{item.title}}</view>
          <view class="reminder-value">{{item.value}}</view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>

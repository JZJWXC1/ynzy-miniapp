<navigation-bar title="房源详情" back="{{true}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell detail-page">
    <block wx:if="{{unavailableListing.unavailable}}">
      <view class="unavailable-card soft-card">
        <view class="unavailable-status">房源已更新</view>
        <view class="unavailable-title">{{unavailableListing.reasonText || '这套房源暂时不能查看'}}</view>
        <view class="unavailable-desc">可能已经下架、过期或正在重新同步。返回上一页继续看原需求，或重新发起找房。</view>
        <view class="unavailable-actions">
          <button class="ghost-button" bindtap="goBackFromUnavailable">返回上一页</button>
          <button class="primary-button" bindtap="goFindHouseFromUnavailable">重新找房</button>
        </view>
      </view>
    </block>
    <block wx:else>
    <block wx:if="{{listing.videoUrl}}">
      <view class="video-card">
        <video
          class="listing-video"
          src="{{listing.videoUrl}}"
          controls
          show-center-play-btn
          object-fit="cover"
        ></video>
      </view>

      <view class="video-share-card">
        <view class="video-share-copy">
          <view class="video-share-title">转发房间视频给租客</view>
          <view class="video-share-sub">{{shareStateText}}</view>
        </view>
        <button
          class="video-share-button"
          loading="{{shareVideoBusy}}"
          bindtap="prepareVideoShare"
          disabled="{{!canShareVideo || shareVideoBusy}}"
        >
          一键转发
        </button>
      </view>
    </block>

    <view class="detail-card soft-card">
      <view class="detail-head">
        <view>
          <view class="listing-title">{{listing.title}}</view>
          <view class="listing-area">{{listing.areaText || listing.area}} · {{listing.status}}</view>
        </view>
        <view class="commission {{listing.noCommission ? 'no-commission' : ''}}">{{listing.commissionText || '成交总比例按成交总佣金的 30% 计算'}}</view>
      </view>
      <view class="source-badges">
        <text wx:if="{{listing.companyListing}}" class="company-badge">公司房源</text>
      </view>
      <view wx:if="{{listing.features}}" class="listing-feature-row">
        <text wx:for="{{listing.features}}" wx:key="*this" class="listing-feature-tag">{{item}}</text>
        <text wx:if="{{listing.maintenanceText}}" class="listing-maintenance-tag">{{listing.maintenanceText}}</text>
      </view>
      <view class="facts">
        <view class="fact"><text>¥{{listing.rent}}/月</text><text>租金</text></view>
        <view class="fact"><text>{{listing.layout}}</text><text>户型</text></view>
        <view class="fact"><text>{{listing.uploader}}</text><text>上传人</text></view>
      </view>
      <view class="location-grid">
        <view class="location-item"><text>城市</text><text>{{listing.city || '杭州'}}</text></view>
        <view class="location-item"><text>区域</text><text>{{listing.district || listing.area}}</text></view>
        <view class="location-item wide"><text>小区名称</text><text>{{listing.community}}</text></view>
        <view class="location-item"><text>几栋</text><text>{{listing.building || '-'}}</text></view>
        <view class="location-item"><text>几单元</text><text>{{listing.unit || '-'}}</text></view>
        <view class="location-item"><text>房间号</text><text>{{listing.roomNumber || '-'}}</text></view>
      </view>
    </view>

    <view class="sensitive-card soft-card">
      <view class="sensitive-head">
        <view>
          <view class="sensitive-title">地址和房东联系方式</view>
          <view wx:if="{{!listing.companyListing && isOwnListing}}" class="sensitive-desc own">自己上传的房源，地址和房东电话已直接展示，不留足迹、不耗额度。</view>
          <view wx:elif="{{!listing.companyListing}}" class="sensitive-desc">查看即留痕，同步给上传人和管理员。</view>
        </view>
        <view class="verify-tag">{{sensitiveAuthLabel}}</view>
      </view>
      <view class="hidden-row">
        <view class="hidden-label">详细地址</view>
        <view class="hidden-value">{{sensitiveVisible ? listing.address : '完成确认后可查看'}}</view>
      </view>
      <view class="hidden-row">
        <view class="hidden-label">{{listing.companyListing ? '公司看房电话' : '房东电话'}}</view>
        <view class="hidden-value">{{sensitiveVisible ? (listing.companyContactPhoneText || listing.landlordPhone) : '完成确认后可查看'}}</view>
      </view>
      <view wx:if="{{!listing.companyListing}}" class="need-bind-row {{needId ? 'bound' : ''}}">
        <view class="need-bind-title">{{needId ? '已绑定需求单' : '未绑定需求单'}}</view>
        <view class="need-bind-desc">{{needId ? needId : '从找房助手进入会自动带入，也可用当前房源创建最小需求。'}}</view>
      </view>
      <button wx:if="{{!listing.companyListing && isOwnListing}}" class="primary-button own" disabled>自己上传·免留痕直接展示</button>
      <button wx:elif="{{!listing.companyListing}}" class="primary-button" bindtap="revealSensitive">{{sensitiveVisible ? '已记录足迹' : '查看地址和电话'}}</button>
      <view wx:if="{{!listing.companyListing}}" class="showing-action-card {{showingSubmitting ? 'is-loading' : ''}}" bindtap="recordShowing">
        <view class="showing-action-copy">
          <text class="showing-action-title">{{showingSubmitting ? '提交审核中' : '拍水印照片记录带看'}}</text>
          <text class="showing-action-sub">现场水印照，审核通过当天生效</text>
        </view>
        <view class="showing-quota-badge">
          <text class="quota-plus">+1</text>
          <text>查看额度</text>
        </view>
      </view>
      <image wx:if="{{!listing.companyListing && showingPhotoPath}}" class="showing-proof-preview" src="{{showingPhotoPath}}" mode="aspectFill"></image>
    </view>

    <view class="section-title">
      <view class="section-title-main">查看足迹</view>
    </view>
    <view class="log-list">
      <view wx:for="{{logs}}" wx:key="time" class="log-card soft-card">
        <view class="log-user">{{item.user}}</view>
        <view class="log-action">{{item.action}}</view>
        <view class="log-time">{{item.time}}</view>
      </view>
    </view>

    <button class="deal-button" bindtap="startReportDeal">先报备客户，再从报备发起签单</button>
    </block>
  </view>
</scroll-view>
<view wx:if="{{reportModalVisible}}" class="v1-modal-mask" catchtap="closeReportModal" catchtouchmove="noop">
  <view class="v1-modal" catchtap="noop">
    <view class="v1-modal-title">客户报备</view>
    <view class="v1-field">
      <text>客户称呼</text>
      <input value="{{reportForm.customerName}}" data-field="customerName" bindinput="updateReportField" placeholder="可选" />
    </view>
    <view class="v1-field">
      <text>客户手机号</text>
      <input value="{{reportForm.customerPhone}}" data-field="customerPhone" bindinput="updateReportField" type="number" maxlength="11" placeholder="必填" />
    </view>
    <view class="v1-modal-actions">
      <button class="ghost-button" bindtap="closeReportModal">取消</button>
      <button class="primary-button" loading="{{reportSubmitting}}" bindtap="submitClientReport">提交报备</button>
    </view>
  </view>
</view>

<view wx:if="{{sensitivePurposeModalVisible}}" class="v1-modal-mask" catchtap="closeSensitivePurposeModal" catchtouchmove="noop">
  <view class="v1-modal" catchtap="noop">
    <view class="v1-modal-title">查看用途</view>
    <view class="modal-sub">查看地址和房东电话前，请选择本次用途并绑定需求单。</view>
    <view class="purpose-options">
      <button
        wx:for="{{sensitivePurposeOptions}}"
        wx:key="*this"
        class="purpose-option {{sensitivePurpose === item ? 'active' : ''}}"
        data-purpose="{{item}}"
        bindtap="chooseSensitivePurpose"
      >
        <text>{{item}}</text>
      </button>
    </view>
    <view class="v1-field">
      <text>补充用途</text>
      <input value="{{sensitivePurposeCustom}}" bindinput="updateSensitivePurposeCustom" placeholder="可选，填写后优先使用" />
    </view>
    <view class="need-modal-note">{{needTemporary ? '当前为临时需求单，可继续验证。' : '需求单会随足迹、报备和签单一起提交。'}}</view>
    <view class="v1-modal-actions">
      <button class="ghost-button" bindtap="closeSensitivePurposeModal">取消</button>
      <button class="primary-button" loading="{{sensitiveSubmitting}}" bindtap="confirmRevealSensitive">确认查看</button>
    </view>
  </view>
</view>

<view wx:if="{{dealModalVisible}}" class="v1-modal-mask" catchtap="closeDealModal" catchtouchmove="noop">
  <view class="v1-modal" catchtap="noop">
    <view class="v1-modal-title">提交签单</view>
    <view class="v1-field">
      <text>成交月租</text>
      <input value="{{dealForm.monthlyRent}}" data-field="monthlyRent" bindinput="updateDealField" type="digit" placeholder="必填" />
    </view>
    <view class="v1-field">
      <text>房东实付佣金</text>
      <input value="{{dealForm.landlordCommission}}" data-field="landlordCommission" bindinput="updateDealField" type="digit" placeholder="必填" />
    </view>
    <view class="v1-field">
      <text>备注</text>
      <textarea value="{{dealForm.remark}}" data-field="remark" bindinput="updateDealField" maxlength="120" placeholder="可选" />
    </view>
    <view class="v1-modal-actions">
      <button class="ghost-button" bindtap="closeDealModal">取消</button>
      <button class="primary-button" loading="{{dealSubmitting}}" bindtap="submitDealFromReport">提交签单</button>
    </view>
  </view>
</view>
<canvas canvas-id="showingWatermarkCanvas" class="showing-watermark-canvas" style="width: {{showingCanvasWidth}}px; height: {{showingCanvasHeight}}px;"></canvas>

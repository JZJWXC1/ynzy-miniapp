page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.detail-page {
  padding-bottom: 64rpx;
}

.video-card {
  height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #182E2A, #2E514A);
  border-radius: 42rpx;
  box-shadow: 0 18rpx 42rpx rgba(46, 81, 74, 0.2);
  overflow: hidden;
}

.listing-video {
  width: 100%;
  height: 100%;
}

.video-share-card {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 34rpx rgba(46, 81, 74, 0.12);
}

.video-share-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.video-share-title {
  color: #182E2A;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.video-share-sub {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 22rpx;
  line-height: 1.35;
}

.video-share-button {
  flex: 0 0 188rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 12rpx;
  color: #182E2A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 72rpx;
  background: #C9A45D;
  border-radius: 22rpx;
}

.video-share-button[disabled] {
  color: #6A7671;
  background: #EDF3EF;
}

.video-share-button::after {
  border: 0;
}

.video-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.play {
  width: 110rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #182E2A;
  font-size: 48rpx;
  background: #C9A45D;
  border-radius: 50%;
}

.video-title {
  margin-top: 28rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.video-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.detail-card,
.sensitive-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.detail-head,
.sensitive-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
}

.listing-title,
.sensitive-title {
  color: #182E2A;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.listing-area,
.sensitive-desc {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 24rpx;
}

.commission,
.verify-tag {
  flex: 0 1 340rpx;
  padding: 10rpx 14rpx;
  color: #182E2A;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.35;
  text-align: center;
  background: #C9A45D;
  border-radius: 18rpx;
}

.commission.no-commission {
  color: #ffffff;
  background: #2E514A;
}

.source-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.company-badge,
.no-commission-badge {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  background: #2E514A;
  border-radius: 14rpx;
}

.no-commission-badge {
  color: #182E2A;
  background: #C9A45D;
}

.facts {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.fact {
  flex: 1 1 190rpx;
  min-width: 0;
  padding: 18rpx;
  background: #EDF3EF;
  border-radius: 22rpx;
}

.fact text:first-child {
  display: block;
  color: #182E2A;
  font-size: 28rpx;
  font-weight: 900;
}

.fact text:last-child {
  display: block;
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 21rpx;
}

.location-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.location-item {
  flex: 1 1 190rpx;
  min-width: 0;
  min-height: 94rpx;
  padding: 16rpx;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 20rpx;
}

.location-item.wide {
  flex-basis: 100%;
}

.location-item text:first-child {
  display: block;
  color: #6A7671;
  font-size: 21rpx;
}

.location-item text:last-child {
  display: block;
  margin-top: 8rpx;
  color: #182E2A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.hidden-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #DED8CC;
}

.hidden-label {
  color: #6A7671;
  font-size: 23rpx;
}

.hidden-value {
  margin-top: 8rpx;
  color: #182E2A;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.4;
}

.need-bind-row {
  margin-top: 18rpx;
  padding: 18rpx;
  background: #F6E9CE;
  border: 1rpx solid #DDC994;
  border-radius: 20rpx;
}

.need-bind-row.bound {
  background: #EDF3EF;
  border-color: #DED8CC;
}

.need-bind-title {
  color: #182E2A;
  font-size: 24rpx;
  font-weight: 900;
}

.need-bind-desc {
  margin-top: 6rpx;
  color: #6A7671;
  font-size: 21rpx;
  line-height: 1.35;
  word-break: break-all;
}

.primary-button,
.deal-button {
  width: 100%;
  height: 84rpx;
  margin-top: 24rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #2E514A;
  border-radius: 26rpx;
}

.ghost-button {
  width: 100%;
  height: 72rpx;
  margin-top: 14rpx;
  color: #2E514A;
  font-size: 25rpx;
  font-weight: 900;
  background: #EDF3EF;
  border-radius: 22rpx;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.log-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  padding: 22rpx;
}

.log-user,
.log-action {
  min-width: 0;
  flex: 1 1 180rpx;
}

.log-time {
  flex: 0 0 auto;
}

.log-user {
  color: #182E2A;
  font-size: 26rpx;
  font-weight: 900;
}

.log-action,
.log-time {
  color: #6A7671;
  font-size: 23rpx;
}

.deal-button {
  background: #B9655A;
}

.showing-proof-preview {
  width: 100%;
  height: 260rpx;
  margin-top: 14rpx;
  border: 1rpx solid #DED8CC;
  border-radius: 20rpx;
  background: #F6F2EA;
}

.showing-watermark-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 900px;
  height: 1200px;
  pointer-events: none;
}
.showing-action-card {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 14rpx 16rpx 14rpx 24rpx;
  color: #2E514A;
  background: #EDF3EF;
  border: 1rpx solid #DED8CC;
  border-radius: 26rpx;
}

.showing-action-card.is-loading {
  opacity: 0.62;
}

.showing-action-copy {
  min-width: 0;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.showing-action-title {
  color: #2E514A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.showing-action-sub {
  margin-top: 6rpx;
  color: #6A7671;
  font-size: 20rpx;
  line-height: 1.25;
}

.showing-quota-badge {
  flex: 0 0 132rpx;
  min-height: 62rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #182E2A;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.15;
  background: #D8BD67;
  border-radius: 20rpx;
}

.quota-plus {
  font-size: 25rpx;
  line-height: 1;
}

.v1-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(28rpx + env(safe-area-inset-top)) 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(24, 46, 42, 0.42);
  box-sizing: border-box;
}

.v1-modal {
  width: 100%;
  max-height: 78vh;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(24, 46, 42, 0.22);
  box-sizing: border-box;
  overflow: auto;
}

.v1-modal-title {
  color: #182E2A;
  font-size: 34rpx;
  font-weight: 900;
}

.modal-sub {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 23rpx;
  line-height: 1.4;
}

.purpose-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.purpose-option {
  flex: 1 1 190rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 8rpx 14rpx;
  color: #2E514A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  background: #EDF3EF;
  border-radius: 18rpx;
  box-sizing: border-box;
  white-space: normal;
}

.purpose-option text {
  display: flex;
  min-height: 52rpx;
  align-items: center;
  justify-content: center;
}

.purpose-option.active {
  color: #ffffff;
  background: #2E514A;
}

.purpose-option::after {
  border: 0;
}

.need-modal-note {
  margin-top: 16rpx;
  color: #7A572D;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.v1-field {
  margin-top: 20rpx;
}

.v1-field text {
  display: block;
  color: #6A7671;
  font-size: 23rpx;
  font-weight: 800;
}

.v1-field input,
.v1-field textarea {
  width: 100%;
  min-height: 78rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  color: #182E2A;
  font-size: 28rpx;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.v1-field textarea {
  min-height: 132rpx;
  padding-top: 18rpx;
  line-height: 1.45;
}

.v1-modal-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.v1-modal-actions .ghost-button,
.v1-modal-actions .primary-button {
  height: 80rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 0;
  padding: 0 12rpx;
  font-size: 26rpx;
  line-height: 1.2;
  border-radius: 20rpx;
  box-sizing: border-box;
  white-space: normal;
}

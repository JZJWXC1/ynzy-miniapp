page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.match-page {
  padding-bottom: 72rpx;
}

.assistant-hero {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 26rpx;
  background: linear-gradient(135deg, #DCEBE9 0%, #ffffff 52%, #F1E4C8 100%);
  border: 1rpx solid rgba(46, 81, 74, 0.14);
  border-radius: 34rpx;
  box-shadow: 0 16rpx 38rpx rgba(36, 62, 56, 0.08);
}

.assistant-hero > view:nth-child(2) {
  min-width: 0;
  flex: 1 1 auto;
}

.hero-logo-wrap {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 26rpx;
}

.hero-logo {
  width: 72rpx;
  height: 72rpx;
}

.hero-title {
  color: #182E2A;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 8rpx;
  color: #66736E;
  font-size: 23rpx;
  line-height: 1.45;
}

.hero-mark {
  width: 64rpx;
  height: 64rpx;
  color: #182E2A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
  background: #C9A45D;
  border-radius: 22rpx;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 24rpx;
}

.message-row {
  display: flex;
}

.message-row.user {
  justify-content: flex-end;
}

.message-bubble {
  max-width: 88%;
  padding: 20rpx 22rpx;
  color: #1E332F;
  font-size: 25rpx;
  line-height: 1.55;
  background: #F6F2EA;
  border-radius: 24rpx;
}

.message-row.assistant .message-bubble {
  background: #EDF3EF;
  border-top-left-radius: 8rpx;
}

.message-row.user .message-bubble {
  color: #ffffff;
  background: #2E514A;
  border-top-right-radius: 8rpx;
}

.input-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.input-title {
  color: #182E2A;
  font-size: 28rpx;
  font-weight: 900;
}

.need-textarea {
  width: 100%;
  min-height: 172rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  color: #182E2A;
  font-size: 25rpx;
  line-height: 1.5;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 22rpx;
}

.voice-textarea {
  width: 100%;
  min-height: 104rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  color: #182E2A;
  font-size: 24rpx;
  line-height: 1.45;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 20rpx;
}

.voice-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 16rpx;
}

.voice-button {
  flex: 0 0 176rpx;
  height: 64rpx;
  color: #182E2A;
  font-size: 24rpx;
  font-weight: 900;
  background: #C9A45D;
  border-radius: 18rpx;
}

.voice-button.active {
  color: #ffffff;
  background: #2E514A;
}

.voice-tip {
  flex: 1 1 auto;
  min-width: 0;
  color: #66736E;
  font-size: 22rpx;
  line-height: 1.35;
}

.demo-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.demo-chip {
  height: 58rpx;
  padding: 0 20rpx;
  color: #2E514A;
  font-size: 23rpx;
  font-weight: 900;
  background: #EDF3EF;
  border-radius: 18rpx;
}

.field-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.field-card {
  flex: 1 1 280rpx;
  min-width: 0;
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 24rpx;
}

.field-card.wide {
  flex-basis: 100%;
}

.field-label {
  color: #6A7671;
  font-size: 21rpx;
  font-weight: 800;
}

.field-card input {
  width: 100%;
  height: 54rpx;
  margin-top: 8rpx;
  color: #182E2A;
  font-size: 26rpx;
  font-weight: 900;
}

.feature-panel,
.guide-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.feature-chip {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  color: #2E514A;
  font-size: 23rpx;
  font-weight: 900;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 18rpx;
}

.feature-chip.active {
  color: #182E2A;
  background: #C9A45D;
  border-color: #C9A45D;
}

.guide-title {
  color: #182E2A;
  font-size: 27rpx;
  font-weight: 900;
}

.guide-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.guide-chip {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  color: #7A572D;
  font-size: 22rpx;
  font-weight: 900;
  background: #F1E4C8;
  border-radius: 16rpx;
}

.match-button {
  width: 100%;
  height: 86rpx;
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 900;
  background: #2E514A;
  border-radius: 26rpx;
}

.confirm-panel {
  margin-top: 20rpx;
  padding: 24rpx;
}

.confirm-desc {
  margin-top: 10rpx;
  color: #66736E;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.confirm-button {
  width: 100%;
  height: 72rpx;
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 72rpx;
  background: #2E514A;
  border-radius: 22rpx;
}

.confirm-button[disabled] {
  opacity: 0.5;
}

.confirm-button::after {
  border: 0;
}

.need-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.need-card {
  flex: 1 1 280rpx;
  min-width: 0;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 24rpx;
}

.need-value {
  color: #182E2A;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
}

.need-label {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 21rpx;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.match-card {
  padding: 24rpx;
}

.match-card-head,
.match-bottom {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
}

.match-main {
  min-width: 0;
}

.match-title {
  color: #182E2A;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.match-meta,
.match-sub {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 23rpx;
  line-height: 1.4;
}

.match-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.match-facts text {
  min-height: 42rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  color: #182E2A;
  font-size: 20rpx;
  font-weight: 900;
  background: #EEF3EF;
  border-radius: 14rpx;
}

.match-score {
  flex: 0 0 auto;
  min-width: 92rpx;
  min-height: 66rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 14rpx;
  color: #182E2A;
  font-weight: 900;
  background: #C9A45D;
  border-radius: 16rpx;
}

.match-score text:first-child {
  font-size: 25rpx;
}

.match-score text:last-child {
  margin-top: 4rpx;
  font-size: 18rpx;
}

.feature-row,
.reason-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.feature-tag,
.maintain-tag,
.reason-row text {
  min-height: 42rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  color: #2E514A;
  font-size: 20rpx;
  font-weight: 900;
  background: #EDF3EF;
  border-radius: 14rpx;
}

.maintain-tag {
  color: #7A572D;
  background: #F1E4C8;
}

.reason-row text {
  color: #62706B;
  background: #F6F2EA;
}

.match-bottom {
  align-items: center;
  margin-top: 16rpx;
}

.match-price {
  color: #B9655A;
  font-size: 32rpx;
  font-weight: 900;
}

.match-tag {
  min-height: 48rpx;
  padding: 0 16rpx;
  color: #2E514A;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 48rpx;
  background: #EDF3EF;
  border-radius: 16rpx;
}

page {
  min-height: 100vh;
  background: #f7fbf8;
}

.map-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
}

.map-header {
  padding: 10rpx 4rpx 18rpx;
}

.map-kicker {
  color: #2f6f60;
  font-size: 23rpx;
  font-weight: 900;
}

.map-title {
  margin-top: 8rpx;
  color: #153f36;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.map-desc {
  margin-top: 10rpx;
  color: #78918a;
  font-size: 25rpx;
  line-height: 1.5;
}

.filter-panel {
  margin-top: 4rpx;
}

.filter-row {
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 58rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  color: #2f6f60;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.filter-chip.active {
  color: #ffffff;
  background: #2f6f60;
  border-color: #2f6f60;
}

.map-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
  color: #153f36;
  font-size: 27rpx;
  font-weight: 900;
}

.map-summary text {
  min-width: 0;
  flex: 1;
  line-height: 1.4;
}

.map-summary button,
.sheet-head button,
.listing-card button {
  flex: 0 0 auto;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #2f6f60;
  background: #e8f5ef;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.real-map-card {
  position: relative;
  height: 720rpx;
  margin-top: 20rpx;
  overflow: hidden;
  background: #eef8f3;
  border: 1rpx solid #dce9e3;
  border-radius: 28rpx;
}

.real-map {
  width: 100%;
  height: 100%;
}

.search-area,
.reset-map {
  position: absolute;
  z-index: 2;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 56rpx;
  box-shadow: 0 8rpx 22rpx rgba(31, 81, 68, 0.16);
}

.search-area {
  left: 50%;
  top: 22rpx;
  color: #ffffff;
  background: #2f6f60;
  transform: translateX(-50%);
}

.reset-map {
  right: 22rpx;
  bottom: 22rpx;
  color: #153f36;
  background: #ffffff;
}

.map-empty {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 560rpx;
  padding: 22rpx 26rpx;
  color: #78918a;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  text-align: center;
  transform: translate(-50%, -50%);
}

.community-sheet {
  margin-top: 24rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 4rpx 2rpx 18rpx;
}

.sheet-title {
  color: #153f36;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.sheet-sub {
  margin-top: 8rpx;
  color: #78918a;
  font-size: 24rpx;
  font-weight: 800;
}

.listing-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 138rpx;
  margin-bottom: 14rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.listing-main {
  min-width: 0;
  flex: 1;
}

.listing-price {
  color: #f2765d;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.listing-meta {
  margin-top: 8rpx;
  color: #153f36;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.listing-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.listing-tags text {
  padding: 7rpx 12rpx;
  color: #2f6f60;
  background: #e8f5ef;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.listing-tags .video-tag {
  color: #153f36;
  background: #f6bd36;
}

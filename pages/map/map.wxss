page {
  min-height: 100vh;
  background: #F6F2EA;
}

.map-page {
  min-height: 100vh;
  /* 底部留足自定义 tab 栏（fixed，高 112rpx + 内边距 + 安全区）的空间，
     否则最底部房源卡片的「看详情」按钮会被 tab 栏遮挡。 */
  padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.map-header {
  padding: 10rpx 4rpx 18rpx;
}

.map-kicker {
  color: #2E514A;
  font-size: 23rpx;
  font-weight: 900;
}

.map-title {
  margin-top: 8rpx;
  color: #182E2A;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.2;
}

.map-desc {
  margin-top: 10rpx;
  color: #6A7671;
  font-size: 25rpx;
  line-height: 1.5;
}

.filter-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 4rpx;
}

.filter-row {
  width: 100%;
  min-height: 58rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 58rpx;
  padding: 0 22rpx;
  color: #2E514A;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.filter-chip.active {
  color: #ffffff;
  background: #2E514A;
  border-color: #2E514A;
}

.custom-rent-row {
  min-height: 62rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.custom-rent-row input {
  flex: 1 1 0;
  min-width: 0;
  height: 62rpx;
  padding: 0 18rpx;
  color: #182E2A;
  font-size: 23rpx;
  font-weight: 800;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.custom-rent-row text {
  color: #6A7671;
  font-size: 24rpx;
  font-weight: 900;
}

.custom-rent-row button {
  flex: 0 0 112rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 62rpx;
  background: #2E514A;
  border-radius: 16rpx;
}

.map-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 22rpx;
  color: #182E2A;
  font-size: 27rpx;
  font-weight: 900;
}

.map-summary text {
  min-width: 0;
  flex: 1;
  line-height: 1.4;
}

.map-summary button,
.sheet-head button,
.listing-card button {
  flex: 0 0 auto;
  min-width: 188rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  color: #2E514A;
  background: #EDF3EF;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.real-map-card {
  position: relative;
  height: 720rpx;
  margin-top: 20rpx;
  overflow: hidden;
  background: #EEF3EF;
  border: 1rpx solid #DED8CC;
  border-radius: 28rpx;
}

.real-map {
  width: 100%;
  height: 100%;
}

.search-area,
.reset-map {
  position: absolute;
  z-index: 2;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 56rpx;
  box-shadow: 0 8rpx 22rpx rgba(36, 62, 56, 0.16);
}

.search-area {
  left: 50%;
  top: 22rpx;
  color: #ffffff;
  background: #2E514A;
  transform: translateX(-50%);
}

.reset-map {
  right: 22rpx;
  bottom: 22rpx;
  color: #182E2A;
  background: #ffffff;
}

.map-empty {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 560rpx;
  padding: 22rpx 26rpx;
  color: #6A7671;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  text-align: center;
  transform: translate(-50%, -50%);
  z-index: 40;
}

.map-login-button {
  width: 240rpx;
  min-height: 76rpx;
  margin: 18rpx auto 0;
  color: #ffffff;
  background: #2f6f60;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.community-sheet {
  margin-top: 24rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 4rpx 2rpx 18rpx;
}

.sheet-title {
  color: #182E2A;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.sheet-sub {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 24rpx;
  font-weight: 800;
}

.listing-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 138rpx;
  margin-bottom: 14rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.listing-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.listing-main {
  min-width: 0;
  flex: 1;
}

.listing-price {
  color: #B9655A;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.listing-meta {
  margin-top: 8rpx;
  color: #182E2A;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.35;
}

.listing-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.listing-tags text {
  padding: 7rpx 12rpx;
  color: #2E514A;
  background: #EDF3EF;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.listing-tags .video-tag {
  color: #182E2A;
  background: #C9A45D;
}

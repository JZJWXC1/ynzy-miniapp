<navigation-bar title="地图找房" back="{{false}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<view class="map-page">
  <view class="map-header">
    <view class="map-kicker">地图找房</view>
    <view class="map-title">已确认坐标小区</view>
    <view class="map-desc">只展示真实且经过确认的小区级位置。</view>
  </view>

  <view class="filter-panel">
    <view class="filter-row">
      <view wx:for="{{rentFilters}}" wx:key="key" class="filter-chip {{filters.rentKey === item.key ? 'active' : ''}}" bindtap="changeRentFilter" data-key="{{item.key}}">{{item.label}}</view>
    </view>
    <view class="filter-row">
      <view wx:for="{{layoutFilters}}" wx:key="*this" class="filter-chip {{(!filters.layout && item === '全部') || filters.layout === item ? 'active' : ''}}" bindtap="changeFilter" data-type="layout" data-value="{{item}}">{{item}}</view>
    </view>
    <view class="filter-row">
      <view wx:for="{{rentModeFilters}}" wx:key="*this" class="filter-chip {{(!filters.rentMode && item === '全部') || filters.rentMode === item ? 'active' : ''}}" bindtap="changeFilter" data-type="rentMode" data-value="{{item}}">{{item}}</view>
    </view>
    <view class="filter-row">
      <view wx:for="{{sourceTypeFilters}}" wx:key="*this" class="filter-chip {{(!filters.sourceType && item === '全部') || filters.sourceType === item ? 'active' : ''}}" bindtap="changeFilter" data-type="sourceType" data-value="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="map-summary">
    <text>{{summaryText}}</text>
    <button bindtap="openAreaListings">列表找房</button>
  </view>

  <view class="real-map-card">
    <map
      id="houseMap"
      class="real-map"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      scale="{{mapScale}}"
      markers="{{markers}}"
      enable-zoom
      enable-scroll
      show-compass
      bindregionchange="handleRegionChange"
      bindmarkertap="handleMarkerTap"
      bindcallouttap="handleMarkerTap"
    >
      <cover-view wx:if="{{showSearchCurrentArea}}" class="search-area" bindtap="searchCurrentRegion">搜索当前区域</cover-view>
      <cover-view class="reset-map" bindtap="resetCenter">重置</cover-view>
    </map>
    <view wx:if="{{!loading && !communities.length}}" class="map-empty">{{emptyText}}</view>
  </view>

  <view wx:if="{{selectedCommunity}}" class="community-sheet">
    <view class="sheet-head">
      <view>
        <view class="sheet-title">{{selectedCommunity.community}}</view>
        <view class="sheet-sub">{{selectedCommunity.listingCount}} 套可租 · {{selectedCommunity.rentRangeText}}</view>
      </view>
      <button bindtap="openAreaListings">看列表</button>
    </view>

    <view wx:for="{{selectedCommunity.listings}}" wx:key="id" class="listing-card">
      <view class="listing-main">
        <view class="listing-price">¥{{item.rent}}/月</view>
        <view class="listing-meta">{{item.layout || '户型待补充'}} · {{item.sourceType || '房源类型待补充'}}</view>
        <view class="listing-tags">
          <text>{{item.maintenanceText || item.lastVerifiedAt || '维护时间待补充'}}</text>
          <text wx:if="{{item.hasVideo}}" class="video-tag">视频</text>
        </view>
      </view>
      <button catchtap="openListing" data-id="{{item.id}}">看详情</button>
    </view>
  </view>
</view>

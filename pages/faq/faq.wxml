<navigation-bar title="常见问题" back="{{true}}" color="#2E6B4E" background="#FBF5EA"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell faq-page">
    <view class="faq-hero">
      <view class="faq-kicker">中介使用帮助</view>
      <view class="faq-title">先把最常遇到的问题讲清楚</view>
      <view class="faq-subtitle">本页无需登录。业务权限、佣金和审计结果始终以服务器当前规则为准。</view>
    </view>

    <view class="faq-list">
      <view wx:for="{{faqItems}}" wx:key="question" class="faq-item">
        <button class="faq-question" bindtap="toggleFaq" data-index="{{index}}" aria-expanded="{{item.open}}">
          <view class="faq-number">{{index + 1}}</view>
          <view class="faq-question-text">{{item.question}}</view>
          <view class="faq-toggle">{{item.open ? '−' : '+'}}</view>
        </button>
        <view wx:if="{{item.open}}" class="faq-answer">{{item.answer}}</view>
      </view>
    </view>

    <view class="faq-footer">页面未解决的问题，请联系团队管理员核对账号或业务规则。</view>
  </view>
</scroll-view>

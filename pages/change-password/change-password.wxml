<navigation-bar title="修改密码" back="{{true}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell change-password-page">
    <view class="cp-card soft-card">
      <view class="cp-field">
        <view class="cp-label">原密码</view>
        <input value="{{form.oldPassword}}" data-field="oldPassword" bindinput="updateField" password="{{true}}" maxlength="32" placeholder="请输入当前登录密码" />
      </view>
      <view class="cp-field">
        <view class="cp-label">新密码</view>
        <input value="{{form.newPassword}}" data-field="newPassword" bindinput="updateField" password="{{true}}" maxlength="32" placeholder="设置至少 8 位新密码" />
      </view>
      <view class="cp-field">
        <view class="cp-label">确认新密码</view>
        <input value="{{form.confirmPassword}}" data-field="confirmPassword" bindinput="updateField" password="{{true}}" maxlength="32" placeholder="请再次输入新密码" />
      </view>
      <button class="cp-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">保存新密码</button>
    </view>
    <view class="cp-note">修改成功后，下次登录请使用新密码。忘记原密码可联系管理员在后台重置。</view>
  </view>
</scroll-view>

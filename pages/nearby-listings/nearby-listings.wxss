.page-scroll {
  height: calc(100vh - 96rpx);
  background: #f7fbf8;
}

.nearby-page {
  padding: 28rpx 24rpx 56rpx;
}

.nearby-hero,
.state-card,
.nearby-card {
  border: 1rpx solid rgba(47, 111, 96, 0.1);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(24, 72, 60, 0.08);
}

.nearby-hero {
  padding: 32rpx;
  background: linear-gradient(145deg, #e7f5ee 0%, #fff9ec 100%);
}

.hero-title {
  color: #153f36;
  font-size: 36rpx;
  font-weight: 750;
}

.hero-sub,
.state-desc {
  margin-top: 10rpx;
  color: #6e8780;
  font-size: 24rpx;
  line-height: 1.55;
}

.hero-count {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #2f6f60;
  font-size: 23rpx;
}

.state-card {
  margin-top: 24rpx;
  padding: 40rpx 28rpx;
  text-align: center;
}

.state-title {
  color: #1d3f37;
  font-size: 30rpx;
  font-weight: 700;
}

.brand-button {
  width: 260rpx;
  min-height: 76rpx;
  margin: 24rpx auto 0;
  border: 0;
  border-radius: 38rpx;
  background: #2f6f60;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 76rpx;
}

.brand-button::after {
  border: 0;
}

.nearby-card {
  display: flex;
  gap: 22rpx;
  margin-top: 24rpx;
  padding: 24rpx;
}

.nearby-cover {
  flex: none;
  width: 202rpx;
  height: 174rpx;
  border-radius: 20rpx;
  background: #e7efeb;
}

.nearby-card-body,
.nearby-card-copy {
  min-width: 0;
  flex: 1;
}

.nearby-card-head,
.nearby-facts,
.nearby-features {
  display: flex;
  align-items: center;
}

.nearby-card-head {
  justify-content: space-between;
  gap: 18rpx;
}

.nearby-card-title {
  overflow: hidden;
  color: #1d3f37;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nearby-distance {
  margin-top: 8rpx;
  color: #d58420;
  font-size: 23rpx;
}

.nearby-facts,
.nearby-features {
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.nearby-facts text,
.nearby-feature {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f6f3;
  color: #56736b;
  font-size: 21rpx;
}

.nearby-facts .price {
  color: #b56d18;
  background: #fff5e5;
}

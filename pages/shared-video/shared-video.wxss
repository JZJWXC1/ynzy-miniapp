page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.shared-video-page {
  padding-bottom: 64rpx;
}

.share-hero {
  height: 430rpx;
  overflow: hidden;
  color: #ffffff;
  background: #153f36;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 42rpx rgba(47, 111, 96, 0.2);
}

.share-video,
.share-placeholder {
  width: 100%;
  height: 100%;
}

.share-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #153f36, #2f6f60);
}

.play {
  width: 110rpx;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #153f36;
  font-size: 44rpx;
  background: #f6bd36;
  border-radius: 50%;
}

.placeholder-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 900;
}

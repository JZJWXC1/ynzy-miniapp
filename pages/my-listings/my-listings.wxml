<navigation-bar title="{{pageTitle}}" back="{{true}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell my-listings-page {{isCompanyMode ? 'company-mode' : ''}}">
    <view class="owner-card">
      <view>
        <view class="owner-title">{{ownerTitle}}</view>
        <view class="owner-desc">{{ownerDesc}}</view>
      </view>
      <button wx:if="{{!isCompanyMode}}" class="owner-button" bindtap="upload">上传</button>
    </view>

    <view wx:if="{{isCompanyMode}}" class="company-filter-panel">
      <view class="filter-section">
        <view class="filter-label">区域</view>
        <view class="filter-tabs">
          <view class="filter-chip {{companyFilters.district === '拱墅区' ? 'active' : ''}}" data-district="拱墅区" bindtap="selectCompanyDistrict">拱墅区</view>
          <view class="filter-chip {{companyFilters.district === '上城区' ? 'active' : ''}}" data-district="上城区" bindtap="selectCompanyDistrict">上城区</view>
          <view class="filter-chip {{!companyFilters.district ? 'active' : ''}}" data-district="" bindtap="selectCompanyDistrict">不限</view>
        </view>
      </view>
      <view class="filter-section">
        <view class="filter-label">板块</view>
        <view class="filter-tabs block-tabs">
          <view class="filter-chip {{!companyFilters.block ? 'active' : ''}}" data-block="" bindtap="selectCompanyBlock">不限</view>
          <view wx:for="{{companyBlockOptions}}" wx:key="*this" class="filter-chip {{companyFilters.block === item ? 'active' : ''}}" data-block="{{item}}" bindtap="selectCompanyBlock">{{item}}</view>
        </view>
      </view>
      <view class="filter-section">
        <view class="filter-label">小区</view>
        <view class="community-combobox">
          <input class="filter-input" value="{{companyFilters.community}}" data-field="community" bindfocus="focusCompanyCommunity" bindinput="updateCompanyFilter" placeholder="输入小区名称" />
          <view wx:if="{{showCompanyCommunityOptions && visibleCompanyCommunities.length}}" class="community-options">
            <view wx:for="{{visibleCompanyCommunities}}" wx:key="*this" class="community-option" data-community="{{item}}" bindtap="selectCompanyCommunity">{{item}}</view>
          </view>
        </view>
      </view>
      <view class="filter-section">
        <view class="filter-label">户型</view>
        <view class="filter-tabs">
          <view wx:for="{{layoutOptions}}" wx:key="*this" class="filter-chip {{(!companyFilters.layout && item === '不限') || companyFilters.layout === item ? 'active' : ''}}" data-layout="{{item}}" bindtap="selectCompanyLayout">{{item}}</view>
        </view>
      </view>
      <view class="price-filter-row">
        <input class="filter-input price-input" value="{{companyFilters.rentMin}}" data-field="rentMin" bindinput="updateCompanyFilter" type="number" placeholder="最低租金" />
        <view class="price-divider"></view>
        <input class="filter-input price-input" value="{{companyFilters.rentMax}}" data-field="rentMax" bindinput="updateCompanyFilter" type="number" placeholder="最高租金" />
        <button class="filter-reset-button" bindtap="resetCompanyFilters">重置</button>
      </view>
    </view>

    <view class="stat-grid">
      <view wx:for="{{stats}}" wx:key="label" class="stat-card">
        <view class="stat-value">{{item.value}}</view>
        <view class="stat-label">{{item.label}}</view>
      </view>
    </view>

    <view class="section-title">
      <view class="section-title-main">{{listTitle}}</view>
    </view>
    <view class="listing-list">
      <view wx:if="{{!listings.length}}" class="empty-card soft-card">
        <view class="empty-title">{{emptyTitle}}</view>
        <view class="empty-desc">{{emptyDesc}}</view>
      </view>
      <block wx:if="{{isCompanyMode}}">
        <view wx:for="{{listings}}" wx:key="id" class="company-listing-card soft-card" bindtap="openListing" data-id="{{item.id}}">
          <view class="company-listing-media">
            <view class="company-video-badge">{{item.videoUrl || item.videoKey || item.video || item.hasVideo ? '视频' : '缺视频'}}</view>
            <image wx:if="{{item.coverUrl || item.videoCoverUrl || item.thumbnailUrl || item.coverImage}}" class="company-media-image" src="{{item.coverUrl || item.videoCoverUrl || item.thumbnailUrl || item.coverImage}}" mode="aspectFill"></image>
            <view wx:else class="company-media-window"></view>
          </view>
          <view class="company-listing-body">
            <view class="company-title-row">
              <text wx:if="{{item.rentMode === '整租'}}" class="company-rent-mode-badge">整</text>
              <text class="company-listing-title">{{item.title}}</text>
            </view>
            <view class="company-listing-meta">{{item.locationSummary || item.community}} · {{item.roomAddress || item.roomNumber || item.block}}</view>
            <view class="company-listing-sub">{{item.layout}} · {{item.sourceLabel || '公司房源'}} · {{item.status}}</view>
            <view wx:if="{{item.features}}" class="listing-feature-row">
              <text wx:for="{{item.features}}" wx:key="*this" class="listing-feature-tag">{{item}}</text>
              <text wx:if="{{item.maintenanceText}}" class="listing-maintenance-tag">{{item.maintenanceText}}</text>
            </view>
            <view class="company-listing-bottom">
              <view class="company-price">{{item.displayRentText}}</view>
              <view class="company-commission">{{item.tag || item.sourceLabel || '公司房源'}}</view>
            </view>
          </view>
        </view>
      </block>
      <block wx:else>
      <view wx:for="{{listings}}" wx:key="id" class="owner-listing soft-card" bindtap="openListing" data-id="{{item.id}}">
        <view class="listing-info">
          <view class="listing-title">{{item.title}}</view>
          <view wx:if="{{isCompanyMode}}" class="listing-location">{{item.displayLocationText}}</view>
          <view wx:else class="listing-location">{{item.locationSummary || item.community}} · {{item.roomAddress || item.roomNumber}}</view>
          <view wx:if="{{isCompanyMode}}" class="listing-meta">{{item.displayRentText}} · {{item.sourceLabel || '公司房源'}}</view>
          <view wx:else class="listing-meta">¥{{item.rent}}/月 · {{item.commissionText || '管理员确认签单后按 20% 结算'}}</view>
          <view wx:if="{{item.features}}" class="listing-feature-row">
            <text wx:for="{{item.features}}" wx:key="*this" class="listing-feature-tag">{{item}}</text>
            <text wx:if="{{item.maintenanceText}}" class="listing-maintenance-tag">{{item.maintenanceText}}</text>
          </view>
          <view wx:if="{{!isCompanyMode}}" class="listing-views">{{item.views}}</view>
          <view wx:if="{{!isCompanyMode}}" class="verify-line {{item.verifyStatus !== '正常' ? 'warn' : ''}}">{{item.verifyStatus}} · {{item.verifyTip}}</view>
        </view>
        <view wx:if="{{!isCompanyMode}}" class="listing-actions">
          <button class="edit-button" catchtap="editListing" data-id="{{item.id}}">编辑</button>
          <button class="verify-button" catchtap="verifyListing" data-id="{{item.id}}">电话确认</button>
          <view class="arrow">›</view>
        </view>
        <view wx:else class="listing-actions company-actions">
          <view class="arrow">›</view>
        </view>
      </view>
      </block>
    </view>
  </view>
</scroll-view>

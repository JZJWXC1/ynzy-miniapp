page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.my-listings-page {
  padding-bottom: 64rpx;
}

.owner-card {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
  padding: 32rpx;
  color: #ffffff;
  background: #2f6f60;
  border-radius: 40rpx;
}

.owner-title {
  font-size: 40rpx;
  font-weight: 900;
}

.owner-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.45;
}

.company-mode .owner-card {
  background: #153f36;
}

.company-filter-panel {
  margin-top: 22rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 26rpx rgba(31, 81, 68, 0.06);
}

.filter-section {
  margin-bottom: 18rpx;
}

.filter-label {
  color: #153f36;
  font-size: 24rpx;
  font-weight: 900;
}

.filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.block-tabs {
  max-height: 184rpx;
  overflow: hidden;
}

.filter-chip {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  color: #2f6f60;
  font-size: 23rpx;
  font-weight: 900;
  background: #f7fbf8;
  border: 1rpx solid #dce9e3;
  border-radius: 16rpx;
}

.filter-chip.active {
  color: #ffffff;
  background: #2f6f60;
  border-color: #2f6f60;
}

.community-combobox {
  position: relative;
  margin-top: 10rpx;
}

.filter-input {
  box-sizing: border-box;
  width: 100%;
  height: 70rpx;
  padding: 0 18rpx;
  color: #153f36;
  font-size: 24rpx;
  font-weight: 800;
  background: #f7fbf8;
  border: 1rpx solid #dce9e3;
  border-radius: 18rpx;
}

.community-options {
  position: absolute;
  left: 0;
  right: 0;
  top: 78rpx;
  z-index: 8;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 18rpx;
  box-shadow: 0 16rpx 32rpx rgba(31, 81, 68, 0.12);
}

.community-option {
  min-height: 62rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  color: #153f36;
  font-size: 24rpx;
  font-weight: 800;
  border-bottom: 1rpx solid #edf4f1;
}

.community-option:last-child {
  border-bottom: 0;
}

.price-filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.price-input {
  flex: 1 1 0;
  min-width: 0;
}

.price-divider {
  flex: 0 0 18rpx;
  height: 2rpx;
  background: #aac3bb;
  border-radius: 999rpx;
}

.filter-reset-button {
  flex: 0 0 104rpx;
  height: 70rpx;
  color: #2f6f60;
  font-size: 24rpx;
  font-weight: 900;
  background: #e9f5f0;
  border-radius: 18rpx;
}

.owner-button {
  min-width: 118rpx;
  height: 72rpx;
  color: #153f36;
  font-size: 26rpx;
  font-weight: 900;
  background: #f6bd36;
  border-radius: 24rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-card {
  flex: 1 1 190rpx;
  min-width: 0;
  padding: 22rpx 8rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 26rpx rgba(31, 81, 68, 0.06);
}

.stat-value {
  color: #153f36;
  font-size: 33rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 6rpx;
  color: #78918a;
  font-size: 22rpx;
}

.listing-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-card {
  padding: 30rpx;
  background: #ffffff;
}

.empty-title {
  color: #153f36;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #78918a;
  font-size: 23rpx;
  line-height: 1.45;
}

.owner-listing {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: stretch;
  padding: 26rpx;
  flex-wrap: wrap;
}

.company-listing-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 18rpx;
}

.company-listing-media {
  flex: 0 0 190rpx;
  min-height: 168rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #d8f4f8, #fff6d8);
  border-radius: 18rpx;
}

.company-media-image {
  width: 100%;
  height: 100%;
  min-height: 168rpx;
}

.company-media-window {
  position: absolute;
  inset: 42rpx 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(47, 111, 96, 0.18);
  border-radius: 16rpx;
}

.company-video-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  z-index: 1;
  padding: 6rpx 12rpx;
  color: #153f36;
  font-size: 20rpx;
  font-weight: 900;
  background: #f6bd36;
  border-radius: 999rpx;
}

.company-listing-body {
  flex: 1 1 0;
  min-width: 0;
}

.company-title-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.company-rent-mode-badge {
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  background: #c0392b;
  border-radius: 6rpx;
}

.company-listing-title {
  min-width: 0;
  color: #153f36;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.28;
}

.company-listing-meta,
.company-listing-sub {
  margin-top: 8rpx;
  color: #78918a;
  font-size: 23rpx;
  line-height: 1.35;
  word-break: break-word;
}

.company-listing-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.company-price {
  color: #153f36;
  font-size: 30rpx;
  font-weight: 900;
}

.company-commission {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  color: #2f6f60;
  font-size: 21rpx;
  font-weight: 900;
  background: #e9f5f0;
  border-radius: 999rpx;
}

.listing-info {
  flex: 1 1 100%;
  min-width: 0;
}

.listing-title {
  color: #153f36;
  font-size: 29rpx;
  font-weight: 900;
}

.listing-location,
.listing-meta,
.listing-views {
  margin-top: 8rpx;
  color: #78918a;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-word;
}

.verify-line {
  margin-top: 10rpx;
  color: #2f6f60;
  font-size: 22rpx;
  font-weight: 900;
}

.verify-line.warn {
  color: #b16a00;
}

.listing-actions {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}

.company-actions {
  min-height: 1rpx;
  padding-top: 0;
}

.edit-button,
.verify-button {
  min-width: 92rpx;
  height: 56rpx;
  padding: 0 18rpx;
  color: #153f36;
  font-size: 22rpx;
  font-weight: 900;
  background: #f6bd36;
  border-radius: 18rpx;
}

.edit-button {
  color: #ffffff;
  background: #2f6f60;
}

.arrow {
  color: #2f6f60;
  font-size: 52rpx;
  font-weight: 300;
}

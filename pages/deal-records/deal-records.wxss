page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.deal-page {
  padding-bottom: 80rpx;
}

.hero-card {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  color: #ffffff;
  background: #2E514A;
  border-radius: 40rpx;
  box-shadow: 0 18rpx 42rpx rgba(46, 81, 74, 0.18);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: #182E2A;
  font-size: 42rpx;
  font-weight: 900;
  background: #C9A45D;
  border-radius: 30rpx;
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.stat-card {
  flex: 1 1 190rpx;
  min-width: 0;
  padding: 22rpx 8rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #DED8CC;
  border-radius: 26rpx;
}

.stat-value {
  color: #182E2A;
  font-size: 34rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 6rpx;
  color: #6A7671;
  font-size: 22rpx;
}

.empty-card {
  padding: 30rpx;
}

.empty-title {
  color: #182E2A;
  font-size: 31rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  color: #6A7671;
  font-size: 24rpx;
  line-height: 1.45;
}

.primary-button {
  width: 100%;
  height: 80rpx;
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  background: #2E514A;
  border-radius: 22rpx;
}

.deal-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.deal-card {
  padding: 24rpx;
}

.deal-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
}

.deal-title {
  color: #182E2A;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.deal-meta {
  margin-top: 8rpx;
  color: #6A7671;
  font-size: 23rpx;
  line-height: 1.35;
}

.status-badge {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  color: #182E2A;
  font-size: 22rpx;
  font-weight: 900;
  background: #C9A45D;
  border-radius: 16rpx;
}

.money-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.money-grid > view {
  min-width: 0;
  padding: 18rpx;
  background: #F6F2EA;
  border: 1rpx solid #DED8CC;
  border-radius: 20rpx;
}

.money-label {
  color: #6A7671;
  font-size: 21rpx;
}

.money-value {
  margin-top: 8rpx;
  color: #182E2A;
  font-size: 28rpx;
  font-weight: 900;
}

.remark-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  color: #6A7671;
  font-size: 23rpx;
  line-height: 1.45;
}

.remark-row text:last-child {
  min-width: 0;
  flex: 1 1 auto;
  color: #182E2A;
  text-align: right;
  word-break: break-all;
}

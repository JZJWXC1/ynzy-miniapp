<!--index.wxml-->
<navigation-bar title="寓你住一起" back="{{true}}" color="#153f36" background="#f7fbf8"></navigation-bar>
<scroll-view class="page-scroll" scroll-y type="list">
  <view class="page-shell home-page">
    <view class="ai-card">
      <view class="ai-head">
        <view class="ai-logo-wrap">
          <image class="ai-logo" src="/assets/logo.png" mode="aspectFit"></image>
        </view>
        <view class="ai-head-text">
          <view class="ai-title">寓你找房助手</view>
          <view class="ai-subtitle">先识别需求，确认字段后再匹配房源</view>
        </view>
      </view>
      <view class="assistant-input-row">
        <input
          class="assistant-input"
          value="{{assistantText}}"
          bindinput="handleAssistantInput"
          bindconfirm="runTextMatch"
          confirm-type="search"
          placeholder="输入预算、区域、户型、特点"
        />
        <view class="mic-button {{isVoiceListening ? 'active' : ''}}" bindtap="toggleVoiceInput" aria-role="button" aria-label="语音输入">
          <view class="mic-icon">
            <view class="mic-head"></view>
            <view class="mic-neck"></view>
            <view class="mic-base"></view>
          </view>
          <view wx:if="{{isVoiceListening}}" class="voice-wave">
            <view class="wave-bar bar-1"></view>
            <view class="wave-bar bar-2"></view>
            <view class="wave-bar bar-3"></view>
            <view class="wave-bar bar-4"></view>
          </view>
        </view>
        <view class="find-button" bindtap="runTextMatch" aria-role="button">
          <text class="find-text">找房</text>
        </view>
      </view>
    </view>

    <view class="company-listing-panel">
      <view class="company-listing-head">
        <view>
          <view class="company-kicker">寓你住一起房源</view>
          <view class="company-title">公司在租房源表</view>
        </view>
        <view class="company-count">{{companyListingCount}} 套在租</view>
      </view>
      <view class="company-table">
        <view class="company-table-row company-table-head">
          <text class="company-col company-col-main">房源</text>
          <text class="company-col company-col-rent">租金</text>
          <text class="company-col company-col-status">维护</text>
        </view>
        <view wx:for="{{companyListingRows}}" wx:key="id" class="company-table-row" bindtap="openListing" data-id="{{item.id}}">
          <view class="company-col company-col-main">
            <view class="company-row-title">{{item.title}}</view>
            <view class="company-row-sub">{{item.location}} · {{item.layout}}</view>
          </view>
          <text class="company-col company-col-rent">{{item.rentText}}</text>
          <text class="company-col company-col-status">{{item.statusText}}</text>
        </view>
        <view wx:if="{{!companyListingRows.length}}" class="company-empty">
          {{companyListingsLoading ? '正在同步公司房源' : '暂无公司在租房源'}}
        </view>
      </view>
      <view class="company-panel-action tap-target" bindtap="openPage" data-url="/pages/my-listings/my-listings?scope=company">查看全部公司房源</view>
    </view>

    <view class="section-title">
      <view class="section-title-main">今日任务</view>
      <view class="section-title-action tap-target" bindtap="openPage" data-url="/pages/profile/profile">我的</view>
    </view>
    <view class="task-list">
      <view wx:for="{{visibleTodayTasks}}" wx:key="type" class="task-card tone-{{item.tone}}" bindtap="openTask" data-url="{{item.url}}">
        <view class="task-main">
          <view class="task-title">{{item.title}}</view>
          <view class="task-desc">{{item.desc}}</view>
        </view>
        <view class="task-count">
          <text>{{item.count}}</text>
          <text>{{item.unit}}</text>
        </view>
      </view>
      <view wx:if="{{!todayTasks.length && !taskLoading}}" class="empty-card soft-card">
        <view class="empty-title">今日任务暂未同步</view>
        <view class="empty-desc">可先进入我的页面查看房态、报备、签单和分佣。</view>
      </view>
      <view wx:if="{{collapsedTaskCount}}" class="task-fold tap-target" bindtap="toggleTaskFold">
        <text class="task-fold-text">{{taskFoldText}}</text>
        <text class="task-fold-meta">{{taskFoldMeta}}</text>
      </view>
    </view>

    <view class="category-grid">
      <view wx:for="{{categories}}" wx:key="name" class="category-card tap-target" bindtap="openCategory" data-name="{{item.name}}">
        <view class="category-icon">{{item.icon}}</view>
        <view class="category-name">{{item.name}}</view>
        <view class="category-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="section-title">
      <view class="section-title-main">找房入口</view>
      <view class="section-title-action tap-target" bindtap="openPage" data-url="/pages/upload/upload">上传房源</view>
    </view>
    <view class="quick-grid">
      <button wx:for="{{quickActions}}" wx:key="title" class="quick-card" bindtap="openPage" data-url="{{item.url}}" hover-class="quick-card-active" hover-stay-time="80">
        <view class="quick-icon">{{item.icon}}</view>
        <view class="quick-content">
          <view class="quick-title">{{item.title}}</view>
          <view class="quick-desc">{{item.desc}}</view>
        </view>
      </button>
    </view>

    <view class="section-title">
      <view class="section-title-main">推荐房源</view>
      <view class="section-title-action tap-target" bindtap="openCategory" data-name="全部">查看全部</view>
    </view>
    <view class="listing-list">
      <view wx:if="{{!listings.length}}" class="empty-card soft-card">
        <view class="empty-title">暂无推荐房源</view>
        <view class="empty-desc">员工上传真实房源后，这里会自动显示可配房源。</view>
      </view>
      <view wx:for="{{listings}}" wx:key="title" class="listing-card soft-card" bindtap="openListing" data-id="{{item.id}}">
        <view class="listing-photo">
          <view class="video-badge">视频</view>
          <view class="photo-window"></view>
        </view>
        <view class="listing-content">
          <view class="listing-title">{{item.title}}</view>
          <view class="listing-meta">{{item.meta}}</view>
          <view class="listing-sub">{{item.sub}}</view>
          <view wx:if="{{item.features}}" class="listing-feature-row">
            <text wx:for="{{item.features}}" wx:key="*this" class="listing-feature-tag">{{item}}</text>
            <text wx:if="{{item.maintenanceText}}" class="listing-maintenance-tag">{{item.maintenanceText}}</text>
          </view>
          <view class="listing-bottom">
            <view class="listing-price">{{item.price}}</view>
            <view class="listing-tag tap-target" bindtap="handleTap" data-name="{{item.tag}}">{{item.tag}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-title">
      <view class="section-title-main">处理规则</view>
      <view class="section-title-action tap-target" bindtap="handleTap" data-name="我的工作台">进入工作台</view>
    </view>
    <view class="workbench-grid">
      <view wx:for="{{workbench}}" wx:key="title" class="workbench-card">
        <view class="workbench-title">{{item.title}}</view>
        <view class="workbench-value">{{item.value}}</view>
      </view>
    </view>
  </view>
</scroll-view>

/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.home-page {
  padding-bottom: 180rpx;
}

.tap-target {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-card {
  position: relative;
  padding: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #aee5f2 0%, #ffffff 45%, #ffffff 100%);
  border: 1rpx solid rgba(47, 111, 96, 0.16);
  border-radius: 40rpx;
  box-shadow: 0 16rpx 38rpx rgba(31, 81, 68, 0.08);
}

.ai-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.ai-head-text {
  min-width: 0;
  flex: 1 1 auto;
}

.ai-logo-wrap {
  width: 78rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 26rpx;
}

.ai-logo {
  width: 62rpx;
  height: 62rpx;
}

.ai-title {
  color: #153f36;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.ai-subtitle {
  margin-top: 6rpx;
  color: #78918a;
  font-size: 23rpx;
  line-height: 1.3;
}

.assistant-input-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 20rpx;
}

.assistant-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 78rpx;
  padding: 0 22rpx;
  color: #153f36;
  font-size: 25rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(47, 111, 96, 0.16);
  border-radius: 20rpx;
}

.mic-button {
  position: relative;
  flex: 0 0 86rpx;
  width: 86rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #f6bd36;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.mic-button.active {
  background: #2f6f60;
  box-shadow: 0 10rpx 24rpx rgba(47, 111, 96, 0.24);
}

.mic-icon {
  position: relative;
  width: 42rpx;
  height: 52rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  z-index: 2;
}

.mic-head {
  width: 24rpx;
  height: 34rpx;
  background: #153f36;
  border-radius: 14rpx;
}

.mic-head::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 8rpx;
  height: 20rpx;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.55);
  border-radius: 8rpx;
}

.mic-neck {
  position: absolute;
  left: 50%;
  top: 32rpx;
  width: 24rpx;
  height: 14rpx;
  transform: translateX(-50%);
  border: 5rpx solid #153f36;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
}

.mic-base {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 30rpx;
  height: 6rpx;
  transform: translateX(-50%);
  background: #153f36;
  border-radius: 999rpx;
}

.mic-base::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 5rpx;
  width: 6rpx;
  height: 12rpx;
  transform: translateX(-50%);
  background: #153f36;
  border-radius: 999rpx;
}

.mic-button.active .mic-head,
.mic-button.active .mic-base,
.mic-button.active .mic-base::before {
  background: #ffffff;
}

.mic-button.active .mic-neck {
  border-color: #ffffff;
}

.voice-wave {
  position: absolute;
  right: 8rpx;
  top: 50%;
  display: flex;
  align-items: center;
  gap: 5rpx;
  transform: translateY(-50%);
  z-index: 1;
  opacity: 0.86;
}

.wave-bar {
  width: 5rpx;
  height: 18rpx;
  background: #ffffff;
  border-radius: 999rpx;
  animation: voiceWave 0.82s ease-in-out infinite;
}

.bar-1 {
  animation-delay: 0s;
}

.bar-2 {
  animation-delay: 0.12s;
}

.bar-3 {
  animation-delay: 0.24s;
}

.bar-4 {
  animation-delay: 0.36s;
}

@keyframes voiceWave {
  0%,
  100% {
    height: 14rpx;
    opacity: 0.58;
  }
  50% {
    height: 42rpx;
    opacity: 1;
  }
}

.find-button {
  flex: 0 0 104rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  background: #2f6f60;
  border-radius: 20rpx;
  flex-shrink: 0;
  line-height: 1;
}

.find-text {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

.category-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.company-listing-panel {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 32rpx rgba(31, 81, 68, 0.08);
}

.company-listing-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.company-kicker {
  color: #2f6f60;
  font-size: 22rpx;
  font-weight: 800;
}

.company-title {
  margin-top: 6rpx;
  color: #153f36;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.company-count {
  flex: 0 0 auto;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  color: #153f36;
  font-size: 22rpx;
  font-weight: 800;
  background: #fff3cf;
  border-radius: 18rpx;
}

.company-table {
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid #dce9e3;
  border-radius: 18rpx;
}

.company-table-row {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  border-top: 1rpx solid #edf3f0;
}

.company-table-row:first-child {
  border-top: 0;
}

.company-table-head {
  min-height: 58rpx;
  color: #78918a;
  font-size: 20rpx;
  font-weight: 900;
  background: #f7fbf8;
}

.company-col-main {
  flex: 1 1 auto;
  min-width: 0;
}

.company-col-rent {
  flex: 0 0 138rpx;
  color: #f2765d;
  font-size: 22rpx;
  font-weight: 900;
  text-align: right;
}

.company-col-status {
  flex: 0 0 112rpx;
  color: #2f6f60;
  font-size: 21rpx;
  font-weight: 900;
  text-align: right;
}

.company-row-title {
  color: #153f36;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.28;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-row-sub {
  margin-top: 6rpx;
  color: #78918a;
  font-size: 20rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.company-empty {
  padding: 28rpx 16rpx;
  color: #78918a;
  font-size: 23rpx;
  font-weight: 800;
  text-align: center;
}

.company-panel-action {
  min-height: 64rpx;
  margin-top: 16rpx;
  color: #2f6f60;
  font-size: 24rpx;
  font-weight: 900;
  background: #e9f5f0;
  border-radius: 18rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-fold {
  min-height: 72rpx;
  justify-content: space-between;
  padding: 0 22rpx;
  color: #2f6f60;
  background: #f7fbf8;
  border: 1rpx dashed #b8d7cd;
  border-radius: 22rpx;
}

.task-fold-text {
  font-size: 24rpx;
  font-weight: 900;
}

.task-fold-meta {
  color: #78918a;
  font-size: 22rpx;
  font-weight: 800;
}

.task-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 120rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 81, 68, 0.06);
}

.task-main {
  min-width: 0;
  flex: 1 1 auto;
}

.task-title {
  color: #153f36;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-desc {
  margin-top: 8rpx;
  color: #78918a;
  font-size: 22rpx;
  line-height: 1.4;
}

.task-count {
  flex: 0 0 116rpx;
  min-height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #153f36;
  background: #e9f5f0;
  border-radius: 20rpx;
}

.task-count text:first-child {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.task-count text:last-child {
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 900;
}

.tone-orange .task-count {
  background: #fff3cf;
}

.tone-blue .task-count {
  background: #e8f7fb;
}

.tone-red .task-count {
  background: #fbe8e3;
}

.tone-yellow .task-count {
  background: #fff35a;
}

.tone-gray .task-count {
  background: #eef2f0;
}

.category-card {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  min-height: 152rpx;
  padding: 18rpx 8rpx;
  flex-direction: column;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 26rpx rgba(31, 81, 68, 0.06);
}

.category-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10rpx;
  color: #2f6f60;
  font-size: 32rpx;
  font-weight: 900;
  background: #e9f5f0;
  border-radius: 22rpx;
}

.category-card:nth-child(2) .category-icon {
  color: #26738a;
  background: #e8f7fb;
}

.category-card:nth-child(3) .category-icon {
  color: #a16f00;
  background: #fff3cf;
}

.category-card:nth-child(4) .category-icon {
  color: #f2765d;
  background: #fbe8e3;
}

.category-name {
  width: 100%;
  color: #153f36;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.category-desc {
  width: 100%;
  margin-top: 6rpx;
  color: #78918a;
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.quick-card {
  flex: 1 1 300rpx;
  width: auto;
  min-width: 0;
  min-height: 220rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  color: #ffffff;
  line-height: normal;
  text-align: left;
  background: #2f6f60;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 42rpx rgba(47, 111, 96, 0.18);
}

.quick-card-active {
  opacity: 0.86;
  transform: scale(0.985);
}

.quick-card:nth-child(2) {
  color: #153f36;
  background: #fff3cf;
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #153f36;
  font-size: 32rpx;
  font-weight: 900;
  background: #f6bd36;
  border-radius: 22rpx;
}

.quick-card:nth-child(2) .quick-icon {
  color: #ffffff;
  background: #2f6f60;
}

.quick-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.quick-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  line-height: 1.45;
}

.quick-card:nth-child(2) .quick-desc {
  color: #6f837c;
}

.need-card {
  padding: 28rpx;
  color: #ffffff;
  background: #2f6f60;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 42rpx rgba(47, 111, 96, 0.18);
}

.need-card-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.need-title {
  font-size: 30rpx;
  font-weight: 900;
}

.need-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
}

.match-score {
  padding: 10rpx 14rpx;
  color: #153f36;
  font-size: 22rpx;
  font-weight: 900;
  background: #f6bd36;
  border-radius: 18rpx;
}

.need-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.need-item {
  flex: 1 1 260rpx;
  min-width: 0;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 22rpx;
}

.need-value {
  font-size: 27rpx;
  font-weight: 900;
}

.need-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
}

.listing-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.empty-card {
  padding: 30rpx;
  background: #ffffff;
}

.empty-title {
  color: #153f36;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #78918a;
  font-size: 23rpx;
  line-height: 1.45;
}

.listing-card {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 20rpx;
}

.listing-photo {
  flex: 0 0 188rpx;
  min-height: 168rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(90deg, #dbe7de 0 28%, #f8efd8 28% 58%, #b8d9d9 58% 100%);
  border-radius: 26rpx;
}

.video-badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  z-index: 2;
  padding: 6rpx 12rpx;
  color: #153f36;
  font-size: 20rpx;
  font-weight: 900;
  background: #f6bd36;
  border-radius: 12rpx;
}

.listing-photo::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 26rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 24rpx 24rpx 12rpx 12rpx;
  box-shadow: 0 -34rpx 0 rgba(47, 111, 96, 0.16);
}

.photo-window {
  position: absolute;
  left: 50rpx;
  top: 54rpx;
  width: 42rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.44);
  border-radius: 16rpx;
}

.listing-content {
  min-width: 0;
  flex: 1 1 auto;
}

.listing-title {
  color: #153f36;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.32;
}

.listing-meta,
.listing-sub {
  margin-top: 8rpx;
  color: #78918a;
  font-size: 23rpx;
  line-height: 1.35;
}

.listing-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.listing-price {
  min-width: 0;
  color: #f2765d;
  font-size: 32rpx;
  font-weight: 900;
}

.listing-tag {
  flex: 0 0 auto;
  height: 48rpx;
  padding: 0 16rpx;
  color: #2f6f60;
  font-size: 22rpx;
  font-weight: 900;
  background: #e9f5f0;
  border-radius: 16rpx;
}

.workbench-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.workbench-card {
  flex: 1 1 300rpx;
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 26rpx rgba(31, 81, 68, 0.06);
}

.workbench-title {
  color: #153f36;
  font-size: 27rpx;
  font-weight: 900;
}

.workbench-value {
  margin-top: 12rpx;
  color: #78918a;
  font-size: 22rpx;
  line-height: 1.45;
}

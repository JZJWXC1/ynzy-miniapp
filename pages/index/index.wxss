/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--brand-cream);
}

.home-page {
  padding-bottom: 180rpx;
}

.tap-target {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-card {
  position: relative;
  padding: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F8FCFA 0%, #FFFDF8 58%, #FFFFFF 100%);
  border: 1rpx solid rgba(23, 61, 51, 0.1);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 32rpx rgba(23, 61, 51, 0.07);
}

.ai-card::before {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 0;
  height: 8rpx;
  background: linear-gradient(90deg, var(--brand-green), #D7B35D, rgba(158, 216, 231, 0.78));
  border-radius: 0 0 999rpx 999rpx;
}

.ai-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.ai-head-text {
  min-width: 0;
  flex: 1 1 auto;
}

.ai-logo-wrap {
  width: 78rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(23, 61, 51, 0.1);
  border-radius: 22rpx;
}

.ai-logo {
  width: 62rpx;
  height: 62rpx;
}

.ai-title {
  color: var(--brand-green);
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.ai-subtitle {
  margin-top: 6rpx;
  color: var(--brand-muted);
  font-size: 23rpx;
  line-height: 1.3;
}

.assistant-input-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 20rpx;
}

.assistant-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 78rpx;
  padding: 0 22rpx;
  color: var(--brand-green-dark);
  font-size: 25rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(23, 61, 51, 0.1);
  border-radius: 18rpx;
}

.mic-button {
  position: relative;
  flex: 0 0 86rpx;
  width: 86rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: var(--brand-yellow-soft);
  border: 1rpx solid rgba(201, 146, 63, 0.22);
  border-radius: 18rpx;
  flex-shrink: 0;
}

.mic-button.active {
  background: var(--brand-green);
  box-shadow: 0 10rpx 22rpx rgba(23, 61, 51, 0.18);
}

.mic-icon {
  position: relative;
  width: 42rpx;
  height: 52rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  z-index: 2;
}

.mic-head {
  width: 24rpx;
  height: 34rpx;
  background: var(--brand-green-dark);
  border-radius: 14rpx;
}

.mic-head::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 8rpx;
  height: 20rpx;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.55);
  border-radius: 8rpx;
}

.mic-neck {
  position: absolute;
  left: 50%;
  top: 32rpx;
  width: 24rpx;
  height: 14rpx;
  transform: translateX(-50%);
  border: 5rpx solid var(--brand-green-dark);
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
}

.mic-base {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 30rpx;
  height: 6rpx;
  transform: translateX(-50%);
  background: var(--brand-green-dark);
  border-radius: 999rpx;
}

.mic-base::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 5rpx;
  width: 6rpx;
  height: 12rpx;
  transform: translateX(-50%);
  background: var(--brand-green-dark);
  border-radius: 999rpx;
}

.mic-button.active .mic-head,
.mic-button.active .mic-base,
.mic-button.active .mic-base::before {
  background: #ffffff;
}

.mic-button.active .mic-neck {
  border-color: #ffffff;
}

.voice-wave {
  position: absolute;
  right: 8rpx;
  top: 50%;
  display: flex;
  align-items: center;
  gap: 5rpx;
  transform: translateY(-50%);
  z-index: 1;
  opacity: 0.86;
}

.wave-bar {
  width: 5rpx;
  height: 18rpx;
  background: #ffffff;
  border-radius: 999rpx;
  animation: voiceWave 0.82s ease-in-out infinite;
}

.bar-1 {
  animation-delay: 0s;
}

.bar-2 {
  animation-delay: 0.12s;
}

.bar-3 {
  animation-delay: 0.24s;
}

.bar-4 {
  animation-delay: 0.36s;
}

@keyframes voiceWave {
  0%,
  100% {
    height: 14rpx;
    opacity: 0.58;
  }
  50% {
    height: 42rpx;
    opacity: 1;
  }
}

.find-button {
  flex: 0 0 104rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  background: var(--brand-green);
  border-radius: 18rpx;
  flex-shrink: 0;
  line-height: 1;
}

.find-text {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

.category-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.top-entry-grid {
  margin-top: 0;
}

.company-sheet-panel {
  margin-top: 22rpx;
  padding: 26rpx;
  background: linear-gradient(180deg, #FFFDF8 0%, #FAF6ED 100%);
  border: 1rpx solid rgba(23, 61, 51, 0.1);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(23, 61, 51, 0.07);
}

.company-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.company-kicker {
  color: var(--brand-green);
  font-size: 22rpx;
  font-weight: 800;
}

.company-title {
  margin-top: 6rpx;
  color: var(--brand-green-dark);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.company-count {
  flex: 0 0 auto;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  color: var(--brand-green-dark);
  font-size: 22rpx;
  font-weight: 800;
  background: var(--brand-yellow-soft);
  border: 1rpx solid rgba(201, 146, 63, 0.2);
  border-radius: 14rpx;
}

.sheet-snapshot-frame {
  position: relative;
  min-height: 430rpx;
  max-height: 460rpx;
  margin-top: 22rpx;
  overflow: hidden;
  background: rgba(255, 253, 248, 0.72);
  border: 1rpx solid rgba(23, 61, 51, 0.1);
  border-radius: 18rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.sheet-snapshot-frame::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, rgba(250, 246, 237, 0), #FAF6ED);
  pointer-events: none;
}

.sheet-snapshot-scroll {
  width: 100%;
  height: 460rpx;
}

.sheet-preview-table {
  box-sizing: content-box;
  padding: 18rpx;
}

.sheet-preview-header,
.sheet-preview-row {
  display: flex;
  min-height: 62rpx;
}

.sheet-preview-th,
.sheet-preview-td,
.sheet-preview-section {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 62rpx;
  padding: 0 14rpx;
  border-right: 1rpx solid rgba(23, 61, 51, 0.14);
  border-bottom: 1rpx solid rgba(23, 61, 51, 0.14);
  overflow: hidden;
}

.sheet-preview-th {
  justify-content: center;
  color: var(--brand-green-dark);
  font-size: 23rpx;
  font-weight: 900;
  background: #F2E3BB;
}

.sheet-preview-th:first-child {
  border-left: 1rpx solid rgba(23, 61, 51, 0.14);
  border-top-left-radius: 10rpx;
}

.sheet-preview-th:last-child {
  border-top-right-radius: 10rpx;
}

.sheet-preview-td {
  color: var(--brand-green-dark);
  font-size: 21rpx;
  line-height: 1.28;
  background: #FFFDF8;
}

.sheet-preview-row:nth-child(odd) .sheet-preview-td {
  background: rgba(234, 242, 236, 0.52);
}

.sheet-preview-td:first-child {
  border-left: 1rpx solid rgba(23, 61, 51, 0.14);
  color: #8F493B;
  font-weight: 900;
  background: #F8EAC9;
}

.sheet-preview-td.strong {
  font-weight: 800;
}

.sheet-preview-section {
  justify-content: center;
  min-height: 54rpx;
  color: #8F493B;
  font-size: 21rpx;
  font-weight: 900;
  background: #F2E3BB;
  border-left: 1rpx solid rgba(23, 61, 51, 0.14);
}

.sheet-preview-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
  line-height: 1.35;
}

.sheet-snapshot-image {
  display: block;
  max-width: none;
  background: #ffffff;
}

.sheet-snapshot-empty {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  text-align: center;
}

.sheet-snapshot-empty-title {
  color: var(--brand-green-dark);
  font-size: 28rpx;
  font-weight: 900;
}

.sheet-snapshot-empty-desc {
  margin-top: 10rpx;
  color: var(--brand-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.sheet-action-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.sheet-action-button {
  flex: 1 1 0;
  min-width: 0;
  height: 68rpx;
  color: var(--brand-green-dark);
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(255, 253, 248, 0.86);
  border: 1rpx solid rgba(23, 61, 51, 0.1);
  border-radius: 14rpx;
}

.sheet-action-button.primary {
  color: #ffffff;
  background: var(--brand-green);
  border-color: var(--brand-green);
}

.sheet-listing-button {
  width: 100%;
  height: 76rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  letter-spacing: 0;
  background: linear-gradient(135deg, #326955 0%, #244F42 100%);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 24rpx rgba(23, 61, 51, 0.16);
}

.sheet-listing-button-active {
  opacity: 0.86;
  transform: scale(0.99);
}

.company-panel-action {
  min-height: 64rpx;
  margin-top: 16rpx;
  color: var(--brand-green);
  font-size: 24rpx;
  font-weight: 900;
  background: rgba(50, 105, 85, 0.09);
  border-radius: 18rpx;
}

.sheet-snapshot-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.maintenance-workbench-section {
  margin-top: 34rpx;
}

.compact-section-title {
  margin-top: 0;
}

.maintenance-task-list {
  margin-top: 0;
}

.task-fold {
  min-height: 72rpx;
  justify-content: space-between;
  padding: 0 22rpx;
  color: var(--brand-green);
  background: rgba(255, 253, 248, 0.86);
  border: 1rpx dashed var(--brand-line);
  border-radius: 22rpx;
}

.task-fold-text {
  font-size: 24rpx;
  font-weight: 900;
}

.task-fold-meta {
  color: var(--brand-muted);
  font-size: 22rpx;
  font-weight: 800;
}

.task-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 120rpx;
  padding: 22rpx;
  background: var(--brand-card);
  border: 1rpx solid var(--brand-line);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 22rpx rgba(23, 61, 51, 0.05);
}

.task-main {
  min-width: 0;
  flex: 1 1 auto;
}

.task-title {
  color: var(--brand-green-dark);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-desc {
  margin-top: 8rpx;
  color: var(--brand-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.task-count {
  flex: 0 0 116rpx;
  min-height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--brand-green-dark);
  background: rgba(50, 105, 85, 0.09);
  border-radius: 20rpx;
}

.task-count text:first-child {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.task-count text:last-child {
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 900;
}

.tone-orange .task-count {
  background: rgba(201, 146, 63, 0.12);
}

.tone-blue .task-count {
  background: rgba(158, 216, 231, 0.24);
}

.tone-red .task-count {
  background: rgba(201, 146, 63, 0.1);
}

.tone-yellow .task-count {
  background: var(--brand-yellow-soft);
}

.tone-gray .task-count {
  background: #eef2f0;
}

.category-card {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  min-height: 152rpx;
  padding: 18rpx 8rpx;
  flex-direction: column;
  background: var(--brand-card);
  border: 1rpx solid var(--brand-line);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(23, 61, 51, 0.05);
}

.category-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10rpx;
  color: var(--brand-green);
  font-size: 32rpx;
  font-weight: 900;
  background: rgba(50, 105, 85, 0.09);
  border-radius: 22rpx;
}

.category-card:nth-child(2) .category-icon {
  color: #2B7180;
  background: var(--brand-blue-soft);
}

.category-card:nth-child(3) .category-icon {
  color: #6D5521;
  background: var(--brand-yellow-soft);
}

.category-card:nth-child(4) .category-icon {
  color: var(--brand-orange);
  background: rgba(201, 146, 63, 0.11);
}

.category-name {
  width: 100%;
  color: var(--brand-green-dark);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.category-desc {
  width: 100%;
  margin-top: 6rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.quick-card {
  flex: 1 1 300rpx;
  width: auto;
  min-width: 0;
  min-height: 236rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  color: #ffffff;
  line-height: normal;
  text-align: left;
  background: linear-gradient(160deg, #3D765F 0%, #2E604F 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 34rpx rgba(23, 61, 51, 0.15);
}

.quick-card-active {
  opacity: 0.86;
  transform: scale(0.985);
}

.quick-card:nth-child(2) {
  color: var(--brand-green-dark);
  background: linear-gradient(160deg, #FFFDF8 0%, #F1E5C9 100%);
  border-color: rgba(109, 85, 33, 0.14);
  box-shadow: 0 16rpx 32rpx rgba(109, 85, 33, 0.08);
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-green-dark);
  font-size: 32rpx;
  font-weight: 900;
  background: rgba(247, 233, 196, 0.95);
  border-radius: 22rpx;
}

.quick-card:nth-child(2) .quick-icon {
  color: #ffffff;
  background: #326955;
}

.quick-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.quick-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
  line-height: 1.45;
}

.quick-card:nth-child(2) .quick-desc {
  color: rgba(23, 61, 51, 0.62);
}

.quick-task-meta {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.quick-task-line {
  min-height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 14rpx;
  color: var(--brand-green-dark);
  font-size: 21rpx;
  font-weight: 900;
  background: rgba(255, 253, 248, 0.62);
  border-radius: 14rpx;
}

.quick-task-line.muted {
  color: var(--brand-green);
  background: rgba(50, 105, 85, 0.09);
}

.workbench-block {
  margin-top: 34rpx;
}

.workbench-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.workbench-section-title {
  color: var(--brand-green-dark);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.workbench-section-action {
  flex: 0 0 auto;
  min-height: 50rpx;
  padding: 0 18rpx;
  color: var(--brand-green);
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(50, 105, 85, 0.09);
  border-radius: 16rpx;
}

.workbench-shortcut-grid {
  margin-top: 18rpx;
}

.need-card {
  padding: 28rpx;
  color: #ffffff;
  background: var(--brand-green);
  border-radius: 36rpx;
  box-shadow: 0 16rpx 34rpx rgba(23, 61, 51, 0.15);
}

.need-card-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.need-title {
  font-size: 30rpx;
  font-weight: 900;
}

.need-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
}

.match-score {
  padding: 10rpx 14rpx;
  color: var(--brand-green-dark);
  font-size: 22rpx;
  font-weight: 900;
  background: var(--brand-yellow);
  border-radius: 18rpx;
}

.need-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.need-item {
  flex: 1 1 260rpx;
  min-width: 0;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 22rpx;
}

.need-value {
  font-size: 27rpx;
  font-weight: 900;
}

.need-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
}

.listing-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.empty-card {
  padding: 30rpx;
  background: var(--brand-card);
}

.empty-title {
  color: var(--brand-green-dark);
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: var(--brand-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.listing-card {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 20rpx;
}

.listing-photo {
  flex: 0 0 188rpx;
  min-height: 168rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(90deg, rgba(50, 105, 85, 0.14) 0 30%, rgba(230, 190, 98, 0.24) 30% 58%, rgba(158, 216, 231, 0.34) 58% 100%);
  border-radius: 20rpx;
}

.video-badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  z-index: 2;
  padding: 6rpx 12rpx;
  color: var(--brand-green-dark);
  font-size: 20rpx;
  font-weight: 900;
  background: var(--brand-yellow);
  border-radius: 12rpx;
}

.listing-photo::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 26rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 24rpx 24rpx 12rpx 12rpx;
  box-shadow: 0 -34rpx 0 rgba(50, 105, 85, 0.12);
}

.photo-window {
  position: absolute;
  left: 50rpx;
  top: 54rpx;
  width: 42rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.44);
  border-radius: 16rpx;
}

.listing-content {
  min-width: 0;
  flex: 1 1 auto;
}

.listing-title-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.rent-mode-badge {
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  background: #c0392b;
  border-radius: 6rpx;
}

.listing-title {
  min-width: 0;
  color: var(--brand-green-dark);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.32;
}

.listing-meta,
.listing-sub {
  margin-top: 8rpx;
  color: var(--brand-muted);
  font-size: 23rpx;
  line-height: 1.35;
}

.listing-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.listing-price {
  min-width: 0;
  color: #B5782E;
  font-size: 32rpx;
  font-weight: 900;
}

.listing-tag {
  flex: 0 0 auto;
  height: 48rpx;
  padding: 0 16rpx;
  color: var(--brand-green);
  font-size: 22rpx;
  font-weight: 900;
  background: rgba(50, 105, 85, 0.09);
  border-radius: 16rpx;
}

.workbench-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.home-workbench-grid {
  margin-top: 18rpx;
}

.workbench-card {
  flex: 1 1 300rpx;
  min-width: 0;
  min-height: 136rpx;
  padding: 24rpx;
  background: var(--brand-card);
  border: 1rpx solid var(--brand-line);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(23, 61, 51, 0.05);
}

.workbench-title {
  color: var(--brand-green-dark);
  font-size: 27rpx;
  font-weight: 900;
}

.workbench-value {
  margin-top: 12rpx;
  color: var(--brand-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

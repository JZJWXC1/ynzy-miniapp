}

.sheet-snapshot-frame::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, rgba(246, 237, 208, 0), #f6edd0);
  pointer-events: none;
}

.sheet-snapshot-scroll {
  width: 100%;
  height: 460rpx;
}

.sheet-preview-table {
  box-sizing: content-box;
  padding: 18rpx;
}

.sheet-preview-header,
.sheet-preview-row {
  display: flex;
  min-height: 62rpx;
}

.sheet-preview-th,
.sheet-preview-td,
.sheet-preview-section {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  min-height: 62rpx;
  padding: 0 14rpx;
  border-right: 1rpx solid #b9a36b;
  border-bottom: 1rpx solid #b9a36b;

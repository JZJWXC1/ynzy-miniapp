/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.home-page {
  padding-bottom: 180rpx;
}

.tap-target {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-card {
  position: relative;
  padding: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #aee5f2 0%, #ffffff 45%, #ffffff 100%);
  border: 1rpx solid rgba(47, 111, 96, 0.16);
  border-radius: 40rpx;
  box-shadow: 0 16rpx 38rpx rgba(31, 81, 68, 0.08);
}

.ai-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.ai-head-text {
  min-width: 0;
  flex: 1 1 auto;
}

.ai-logo-wrap {
  width: 78rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 1rpx solid #dce9e3;
  border-radius: 26rpx;
}

.ai-logo {
  width: 62rpx;
  height: 62rpx;
}

.ai-title {
  color: #153f36;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.2;
}

.ai-subtitle {
  margin-top: 6rpx;
  color: #78918a;
  font-size: 23rpx;
  line-height: 1.3;
}

.assistant-input-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  margin-top: 20rpx;
}

.assistant-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 78rpx;
  padding: 0 22rpx;
  color: #153f36;
  font-size: 25rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(47, 111, 96, 0.16);
  border-radius: 20rpx;
}

.mic-button {
  position: relative;
  flex: 0 0 86rpx;
  width: 86rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #f6bd36;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.mic-button.active {
  background: #2f6f60;
  box-shadow: 0 10rpx 24rpx rgba(47, 111, 96, 0.24);
}

.mic-icon {
  position: relative;
  width: 42rpx;
  height: 52rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  z-index: 2;
}

.mic-head {
  width: 24rpx;
  height: 34rpx;
  background: #153f36;
  border-radius: 14rpx;
}

.mic-head::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 8rpx;
  height: 20rpx;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.55);
  border-radius: 8rpx;
}

.mic-neck {
  position: absolute;
  left: 50%;
  top: 32rpx;
  width: 24rpx;
  height: 14rpx;
  transform: translateX(-50%);
  border: 5rpx solid #153f36;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
}

.mic-base {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 30rpx;
  height: 6rpx;
  transform: translateX(-50%);
  background: #153f36;
  border-radius: 999rpx;
}

.mic-base::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 5rpx;
  width: 6rpx;
  height: 12rpx;
  transform: translateX(-50%);
  background: #153f36;
  border-radius: 999rpx;
}

.mic-button.active .mic-head,
.mic-button.active .mic-base,
.mic-button.active .mic-base::before {
  background: #ffffff;
}

.mic-button.active .mic-neck {
  border-color: #ffffff;
}

.voice-wave {
  position: absolute;
  right: 8rpx;
  top: 50%;
  display: flex;
  align-items: center;
  gap: 5rpx;
  transform: translateY(-50%);
  z-index: 1;
  opacity: 0.86;
}

.wave-bar {
  width: 5rpx;
  height: 18rpx;
  background: #ffffff;
  border-radius: 999rpx;
  animation: voiceWave 0.82s ease-in-out infinite;
}

.bar-1 {
  animation-delay: 0s;
}

.bar-2 {
  animation-delay: 0.12s;
}

.bar-3 {
  animation-delay: 0.24s;
}

.bar-4 {
  animation-delay: 0.36s;
}

@keyframes voiceWave {
  0%,
  100% {
    height: 14rpx;
    opacity: 0.58;
  }
  50% {
    height: 42rpx;
    opacity: 1;
  }
}

.find-button {
  flex: 0 0 104rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  background: #2f6f60;
  border-radius: 20rpx;
  flex-shrink: 0;
  line-height: 1;
}

.find-text {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

.category-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.top-entry-grid {
  margin-top: 0;
}

.company-sheet-panel {
  margin-top: 22rpx;
  padding: 26rpx;
  background: linear-gradient(180deg, #fbf7e9 0%, #f8fbf4 100%);
  border: 1rpx solid #e0cf9c;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 42rpx rgba(36, 68, 61, 0.12);
}

.company-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.company-kicker {

}

.sheet-preview-th {
  justify-content: center;
  color: #20251f;
  font-size: 23rpx;
  font-weight: 900;
  background: #ffe08a;
}

.sheet-preview-th:first-child {
  border-left: 1rpx solid #b9a36b;
  border-top-left-radius: 10rpx;
}

.sheet-preview-th:last-child {
  border-top-right-radius: 10rpx;
}

.sheet-preview-td {
  color: #2e3f3a;
  font-size: 21rpx;
  line-height: 1.28;
  background: #f1efea;
}

.sheet-preview-row:nth-child(odd) .sheet-preview-td {
  background: #e8ebe3;
}

.sheet-preview-td:first-child {
  border-left: 1rpx solid #b9a36b;
  color: #b00000;
  font-weight: 900;
  background: #fff2cc;
}

.sheet-preview-td.strong {
  font-weight: 800;
}

.sheet-preview-section {
  justify-content: center;
  min-height: 54rpx;
  color: #e00000;
  font-size: 21rpx;
  font-weight: 900;
  background: #ffd45f;

PORT=3101
DATA_FILE=data/db.json

# 小程序接口地址示例：http://127.0.0.1:3101
# 视频存储：正式上线时请补齐 Bucket、Region、AccessKey 或 STS
ALI_OSS_HOME_URL=https://bj33856.apps.aliyunfile.com/disk/admin/home
ALI_OSS_PUBLIC_BASE_URL=
ALI_OSS_BUCKET=
ALI_OSS_REGION=oss-cn-beijing
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_SECURITY_TOKEN=
ALI_OSS_UPLOAD_DIR=house-videos
ALI_OSS_MAX_VIDEO_MB=300
ALI_OSS_POLICY_EXPIRE_SECONDS=900
ALI_OSS_READ_URL_EXPIRE_SECONDS=900

# Web 管理后台 Token 签名密钥，正式上线请改为强随机字符串
ADMIN_TOKEN_SECRET=

# 小程序登录 Token 签名密钥，正式上线请改为强随机字符串
AUTH_TOKEN_SECRET=

# 生产 db.json 异地加密备份（详见 server/README.md「异地加密备份」章节）
# 加密口令：强随机串、异地保管，丢失即无法恢复；缺失时备份脚本拒绝运行
BACKUP_ENCRYPTION_KEY=
# 本地加密备份暂存目录（默认 server/backups/，已 gitignore）；保留天数；新鲜度阈值(小时)
BACKUP_STAGE_DIR=
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=24
# 仅本地开关：设为 1 才允许「无异地目标、仅本地备份」成功；生产禁止开启（会失去异地容灾）
BACKUP_ALLOW_LOCAL_ONLY=
# 注意：异地上传命令 BACKUP_REMOTE_CMD（生产必填，缺失即判失败）与外部通知命令 BACKUP_ALERT_CMD
# 含远端目标/凭据，只在服务器环境文件配置、只在 README 说明，禁止写入本仓库。
# 飞书云盘异地备份凭据（BACKUP_REMOTE_CMD='node scripts/upload-backup-to-feishu.js' 时用；值含空格须加引号）：
# 只放服务器 /etc/default/ynzy-backup，飞书云盘只放 .ygbak，绝不放 BACKUP_ENCRYPTION_KEY。
FEISHU_BACKUP_APP_ID=
FEISHU_BACKUP_APP_SECRET=
FEISHU_BACKUP_FOLDER_TOKEN=
FEISHU_BACKUP_UPLOAD_NAME_PREFIX=

# LLM 密钥只放服务端环境变量，不放小程序前端
LLM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=

# 飞书公司房源同步：房源表为准，素材库命中视频才上架
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SHEET_URL=https://ccn9urs7d60k.feishu.cn/sheets/H7f8sxOrUhYCK8tev29cwSimnsl
FEISHU_SHEET_TOKEN=H7f8sxOrUhYCK8tev29cwSimnsl
FEISHU_SHEET_ID=
FEISHU_SHEET_RANGE=A1:Z1000
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_MATERIAL_FOLDER_TOKEN=
FEISHU_PAGE_SIZE=50
FEISHU_MAX_FOLDER_DEPTH=8
FEISHU_UPLOAD_TO_OSS=true
FEISHU_SYNC_INTERVAL_MINUTES=30
FEISHU_SYNC_HEALTH_MAX_AGE_MINUTES=1080

# 可选：没有接飞书开放平台时，可先用导出的 JSON 文件预演同步
FEISHU_RECORDS_FILE=
FEISHU_MATERIALS_FILE=

# 积分充值方式：manual 表示后台人工确认；以后接微信支付时改为 wechat
RECHARGE_PAYMENT_MODE=manual
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
WECHAT_PAY_PUBLIC_KEY_PATH=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_TEST_OPENID=
